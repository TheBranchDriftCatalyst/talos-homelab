# load the dev shell from flake.nix (cached by nix-direnv)
#
# Plain `use flake` on purpose, NOT `use flake "path:$PWD"`. In a git repo nix
# copies only TRACKED files into the store; `path:` would copy the whole working
# tree — including .scratch/'s 2.2 GB of archived CA material — on every lock
# change. Corollary: flake.nix must stay git-tracked, or this fails with
# "path does not exist".
use flake

# repo-local prompt: starship reads this env var, direnv unsets it on exit
export STARSHIP_CONFIG="$PWD/dev/starship.toml"

# yamllint only auto-discovers .yamllint{,.yaml,.yml} by walking UP from the
# CWD — it never looks in dev/. Every call site passes -c explicitly
# (dev/Taskfile.dev.yaml, lefthook.yaml); this makes an ad-hoc `yamllint foo.yaml`
# use the project rules too, instead of silently falling back to defaults.
export YAMLLINT_CONFIG_FILE="$PWD/dev/yamllint.yaml"

# secrets: op:// refs in .env.tpl → env vars (use_onepassword comes from
# home-manager's direnv stdlib — the "operator" half of the pattern);
# guarded so a machine that hasn't switched yet still gets a working shell
if declare -F use_onepassword >/dev/null; then
  use_onepassword .env.tpl
else
  log_error "use_onepassword not provisioned (run dotfiles switch) — secrets NOT loaded"
fi

# The 1Password Connect bootstrap credential is a FILE, not an env var, so
# `op inject` cannot render it. use_onepassword_file (same direnv stdlib) wraps
# `op read --out-file` and caches: an existing file is left alone.
# OP_CREDENTIALS_FILE is already an honoured override at dev/Taskfile.infra.yaml:76,94.
export OP_CREDENTIALS_FILE="$PWD/.secrets/1password-credentials.json"
if declare -F use_onepassword_file >/dev/null; then
  # Item "catalyst-eso Credentials File" (DOCUMENT), addressed by UUID because
  # its title contains spaces; the last segment is the attached file's name.
  use_onepassword_file \
    "op://catalyst-eso/slnjt45amko6lyginscadevvve/1password-credentials.json" \
    "$OP_CREDENTIALS_FILE"
fi

# un-vaulted local overrides (gitignored) — wins over .env.tpl values
dotenv_if_exists .env.local

# git hooks — replaces package.json's `postinstall: lefthook install`.
#
# THREE things this has to get right, all learned the hard way (TALOS-u8xj):
#
#   1. THE HOOKS PATH IS NOT .git/hooks. beads sets core.hooksPath to
#      .beads/hooks, so git never reads .git/hooks and the pre-commit still
#      sitting there is a pre-beads fossil that is never executed. The old
#      guard tested that fossil, whose mtime predates every lefthook.yaml edit,
#      so the mtime test was permanently true and this block ran on EVERY load.
#      `git rev-parse --git-path hooks` honours core.hooksPath, so it resolves
#      the directory git will actually run.
#
#   2. WHEN THE PATH IS EXTERNALLY MANAGED, VERIFY — NEVER INSTALL. The hooks
#      under .beads/hooks are git-TRACKED composites: lefthook's wrapper, plus
#      a `BEGIN BEADS INTEGRATION` block, plus the trailing exit-code
#      propagation that is the only reason lefthook's verdict can block a
#      commit at all (see lefthook.yaml's markdownlint comment). `lefthook
#      install` cannot reproduce any of that — it rewrites each hook from its
#      own template. Measured, not assumed: `lefthook install --force` deleted
#      151 lines across 5 tracked hooks, taking the beads block and the
#      propagation with them and silently restoring the very hook-ignores-
#      lefthook bug those lines were added to fix. `--reset-hooks-path` is
#      worse still: it unsets core.hooksPath and breaks beads outright. So the
#      install is confined to the case where git really does use .git/hooks;
#      with a custom path, `git checkout` is what installs the hooks and this
#      block only asserts they are wired.
#
#   3. THE STATUS MUST NOT ESCAPE. This is the last statement in .envrc, so a
#      non-zero status here becomes direnv's "error exit status 1" for the
#      whole environment — which breaks `direnv exec`, which is exactly the
#      fallback lefthook.yaml's markdownlint job takes when markdownlint-cli2
#      is absent from PATH. One refused hook install therefore disabled a lint
#      gate repo-wide. But a bare `|| true` would be worse than the loud
#      failure it replaces: it would hide genuinely unwired hooks. So every
#      branch reports through log_error (which exits 0) and the closing `unset`
#      is what pins this block's status to 0.
_lh_hooks_dir="$(git rev-parse --git-path hooks 2>/dev/null)"
if [ -z "$_lh_hooks_dir" ]; then
  log_error "not a git work tree — lefthook hooks NOT verified"
elif [ -n "$(git config --get core.hooksPath 2>/dev/null)" ]; then
  # core.hooksPath set by beads: the hooks are tracked in git, so assert
  # rather than overwrite. Mentioning lefthook is the minimum bar — a hook
  # that does not is either the pre-beads fossil or a beads re-init that
  # dropped the lefthook half.
  if ! grep -q 'call_lefthook run' "$_lh_hooks_dir/pre-commit" 2>/dev/null; then
    log_error "git hooks in $_lh_hooks_dir do NOT invoke lefthook — lint gates are OFF; restore with 'git checkout -- .beads/hooks' (do NOT run 'lefthook install', it strips the beads block)"
  fi
elif [ ! -f "$_lh_hooks_dir/pre-commit" ] || [ lefthook.yaml -nt "$_lh_hooks_dir/pre-commit" ]; then
  if lefthook install >/dev/null 2>&1; then
    log_status "lefthook: git hooks installed"
  else
    log_error "lefthook install FAILED — git hooks are STALE and may not run; fix with 'lefthook install'"
  fi
fi
unset _lh_hooks_dir

# NOT exported here on purpose:
#   KUBECONFIG / TALOSCONFIG — Taskfile.yaml:17 sets both per-invocation, and a
#     global export would shadow the ~/.kube/config that task k8s:kubeconfig-merge
#     builds, for every ad-hoc kubectl.
#   TALOS_NODE — Taskfile.yaml:15 already defaults it to 192.168.1.54; a
#     per-machine override belongs in .env.local.
