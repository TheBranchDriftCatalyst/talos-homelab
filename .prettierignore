# Prettier Ignore
# Single source of truth for prettier file exclusions

# Package managers
node_modules/

# Build outputs
.output/
dist/
build/

# Git
.git/

# Claude Code agent/workflow worktrees — full repo checkouts nested INSIDE the repo.
# Without this, any repo-wide tool (prettier, sed, find) rewrites all of them at once.
# See docs/02-architecture/repo-restructure-plan.md §18.
.claude/
**/.claude/

# Python virtual environments
.venv/
**/.venv/
**/.*venv/
tools/*/.venv/

# Flux system generated files
clusters/catalyst-cluster/flux-system/

# Talos configs (sensitive)
configs/*.yaml

# Helm chart templates (Go templating syntax)
charts/*/templates/*.yaml

# Lock files
*.lock
yarn.lock
package-lock.json
