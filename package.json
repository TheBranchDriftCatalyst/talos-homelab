{
  "name": "talos-homelab",
  "version": "1.0.0",
  "private": true,
  "description": "Talos Linux single-node Kubernetes cluster infrastructure",
  "scripts": {
    "postinstall": "lefthook install",
    "test": "node scripts/jest-select.js",
    "test:all": "jest",
    "test:dr": "PIHOLE_DR_DESTRUCTIVE=1 VPN_DR_DESTRUCTIVE=1 jest",
    "test:discord": "DISCORD_WEBHOOK_TEST=1 jest --selectProjects discord-webhook",
    "test:mail": "MAIL_TEST_SEND=1 jest --selectProjects mail-relay",
    "lint": "run-s lint:*",
    "lint:markdown": "markdownlint-cli2",
    "lint:prettier": "prettier --check .",
    "format": "run-s format:*",
    "format:markdown": "markdownlint-cli2 --fix",
    "format:prettier": "prettier --write .",
    "hooks:install": "lefthook install",
    "hooks:uninstall": "lefthook uninstall",
    "validate": "task validate"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "markdownlint-cli2": "^0.19.1",
    "npm-run-all2": "^7.0.2",
    "prettier": "^3.4.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "yarn": ">=1.22.0"
  }
}
