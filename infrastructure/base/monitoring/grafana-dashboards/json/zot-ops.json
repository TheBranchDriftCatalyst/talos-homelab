{
  "uid": "zot-ops",
  "title": "Zot Registry Ops",
  "description": "Zot OCI registry. Built against the metrics this build actually exports (binaryType -events-imagetrust-lint-metrics-mgmt-profile-scrub-search-sync-ui-userprefs); zot registers many counters lazily, so a panel can be empty simply because that code path has not run yet.",
  "tags": [
    "ops",
    "registry",
    "zot",
    "storage"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "repo",
        "label": "Repository",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "definition": "label_values(zot_repo_storage_bytes, repo)",
        "query": {
          "query": "label_values(zot_repo_storage_bytes, repo)",
          "refId": "repo"
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1,
        "options": []
      }
    ]
  },
