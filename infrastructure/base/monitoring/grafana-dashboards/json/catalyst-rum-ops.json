{
  "uid": "catalyst-rum-ops",
  "title": "Catalyst RUM Ops",
  "description": "Browser real-user monitoring for the Catalyst apps, fused with Traefik server-side latency.\n\nBrowser signals come from Alloy's faro.receiver -> Loki, labelled {app, kind}. Server signals come from Traefik -> Mimir. Sibling of 'Analytics Ops', which covers the Plausible stack.",
  "tags": [
    "analytics",
    "rum",
    "faro",
    "frontend",
    "ops"
  ],
  "editable": true,
  "schemaVersion": 39,
  "graphTooltip": 1,
  "timezone": "",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "app",
        "label": "App",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki-v2"
        },
        "includeAll": true,
        "multi": true,
        "query": {
          "label": "app",
          "stream": "{kind=\"measurement\"}",
          "type": 1
        },
        "refresh": 2,
        "sort": 1,
        "description": "Apps currently reporting browser telemetry."
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Core Web Vitals \u2014 what users actually experienced",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "p75 FCP",
      "description": "First Contentful Paint. Good <1.8s, poor >3s (web.dev). p75 is the reporting convention \u2014 the experience of the slowest quarter of loads.",
      "datasource": {
        "type": "loki",
        "uid": "loki-v2"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki-v2"
          },
          "expr": "quantile_over_time(0.75, {app=~\"$app\", kind=\"measurement\"} | logfmt | value_fcp != \"\" | unwrap value_fcp [$__range])",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1800
              },
              {
                "color": "red",
                "value": 3000
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
