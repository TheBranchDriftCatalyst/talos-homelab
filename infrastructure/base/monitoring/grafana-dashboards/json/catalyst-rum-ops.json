    {
      "type": "timeseries",
      "title": "Browser TTFB vs Traefik service duration (p75, same axis)",
      "description": "THE FUSION PANEL. Both series are milliseconds, so they share one axis \u2014 this is not a dual-axis chart.\n\nTraefik measures only its own proxy+backend time. The browser's TTFB additionally contains DNS, TLS, connection setup and client-side queueing. The GAP between the two lines is everything Traefik structurally cannot see, and it is where 'the homelab feels slow' usually lives.\n\nNB: this comparison only became possible on 2026-09-25 \u2014 before that Traefik's histogram buckets were 0.1/0.3/1.2/5.0 and 94% of requests fell in the first one, so every server-side quantile pinned at ~0.1s (TALOS-xfjl.8).",
      "datasource": {
        "type": "loki",
        "uid": "loki-v2"
      },
      "gridPos": {
        "h": 9,
        "w": 14,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki-v2"
          },
          "expr": "quantile_over_time(0.75, {app=~\"$app\", kind=\"measurement\"} | logfmt | value_ttfb != \"\" | unwrap value_ttfb [$__auto])",
          "refId": "A",
          "queryType": "range",
          "legendFormat": "browser TTFB (p75)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "histogram_quantile(0.75, sum by (le) (rate(traefik_service_request_duration_seconds_bucket{service=~\"catalyst.*\"}[$__rate_interval]))) * 1000",
          "refId": "B",
          "legendFormat": "traefik service (p75)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "last",
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
