    {
      "type": "stat",
      "title": "Injection error %",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "Percentage of tracking-route requests returning 5xx (ingestion errors).",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 12,
        "y": 1
      },
      "id": 6,
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum(rate(traefik_router_requests_total{router=~\".*plausible.*tracking.*\",code=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(traefik_router_requests_total{router=~\".*plausible.*tracking.*\"}[$__rate_interval])), 0.0001) * 100",
          "refId": "A",
          "legendFormat": "5xx %"
        }
      ]
    },
