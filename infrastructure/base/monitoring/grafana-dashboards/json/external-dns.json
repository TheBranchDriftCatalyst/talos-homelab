{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "enable": true,
        "hide": false,
        "iconColor": "rgba(255, 96, 96, 1)",
        "name": "DNS record change",
        "expr": "changes(external_dns_registry_endpoints_total{job=\"external-dns\"}[2m]) != 0",
        "step": "60s",
        "titleFormat": "endpoints changed"
      }
    ]
  },
  "description": "Operational view of external-dns (Cloudflare provider, zone knowledgedump.space). Answers 'what records do I actually manage?' via a Loki-sourced record-change audit and live registry counts, plus real sync/health signal (last-sync AGE, drift between desired and managed, error rates).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "preload": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 100,
      "panels": [],
      "title": "Status & Sync Health",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "Is the external-dns controller pod up and being scraped? Sourced from the Prometheus `up` series for the external-dns job.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 1
                }
              }
            },
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 0
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "max(up{job=~\"$instance\"})",
          "legendFormat": "up"
        }
      ],
      "title": "Controller Health",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "Time since the last SUCCESSFUL sync with Cloudflare. This is the number that matters \u2014 a low age means records are being reconciled. Green < 3 min (interval is 1 min), amber < 5 min, red = stale (controller stuck / provider unreachable).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 180
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 3,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "time() - max(external_dns_controller_last_sync_timestamp_seconds{job=~\"$instance\"})",
          "legendFormat": "sync age"
        }
      ],
      "title": "Last Sync Age",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "Time since the last reconcile loop ran (with or without changes). Confirms the controller loop is alive independent of whether a provider sync was needed.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 180
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 6,
        "y": 1
      },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "time() - max(external_dns_controller_last_reconcile_timestamp_seconds{job=~\"$instance\"})",
          "legendFormat": "reconcile age"
        }
      ],
      "title": "Last Reconcile Age",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "How many DNS records external-dns currently OWNS in Cloudflare (tracked via the TXT registry, owner id `talos-homelab`). This is the count behind the inventory table below.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 9,
        "y": 1
      },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "max(external_dns_registry_endpoints_total{job=~\"$instance\"})",
          "legendFormat": "managed"
        }
      ],
      "title": "Managed Records",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "How many records the SOURCES (ingress, traefik-proxy, DNSEndpoint CRDs) want to exist. Compare with Managed Records \u2014 the difference is drift (see next panel).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          },
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 12,
        "y": 1
      },
      "id": 5,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "max(external_dns_source_endpoints_total{job=~\"$instance\"})",
          "legendFormat": "desired"
        }
      ],
      "title": "Desired Records (sources)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "Desired \u2212 Managed. Records the sources want that external-dns does not (yet) own. A small non-zero value is expected (policy is upsert-only, and the root A record is owned by the separate cloudflare-ddns deployment, not this registry). A growing value means reconciliation is failing to keep up.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "orange",
                "value": 5
              }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 15,
        "y": 1
      },
      "id": 6,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "max(external_dns_source_endpoints_total{job=~\"$instance\"}) - max(external_dns_registry_endpoints_total{job=~\"$instance\"})",
          "legendFormat": "drift"
        }
      ],
      "title": "Unreconciled (drift)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "Errors talking to the SOURCES (k8s API) in the last 15 min, plus provider/registry errors. Any non-zero value here is why the sync age above might be climbing. Sums `source_errors_total` + `registry_errors_total`.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 18,
        "y": 1
      },
      "id": 7,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum(increase(external_dns_registry_errors_total{job=~\"$instance\"}[15m])) + sum(increase(external_dns_source_errors_total{job=~\"$instance\"}[15m]))",
          "legendFormat": "errors"
        }
      ],
      "title": "Errors (15m)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "Reconcile loops in the last 15 min that completed with no change needed (`no_op_runs_total`). A steady non-zero rate is the healthy heartbeat \u2014 the controller is looping (every ~1 min) and Cloudflare already matches desired state.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 21,
        "y": 1
      },
      "id": 8,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum(increase(external_dns_controller_no_op_runs_total{job=~\"$instance\"}[15m]))",
          "legendFormat": "no-op runs"
        }
      ],
      "title": "Reconcile Heartbeat (15m)",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 101,
      "panels": [],
      "title": "Record Inventory \u2014 What external-dns Manages",
      "type": "row"
    },
    {
      "id": 9,
      "type": "table",
      "title": "Record Inventory \u2014 live from Cloudflare",
      "description": "Every DNS record in the zone (via the cf-records exporter). managed=true \u2192 owned by external-dns.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 12,
        "w": 18,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "A",
          "editorMode": "code",
          "expr": "external_dns_cf_record_info",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "endpoint": true,
              "namespace": true,
              "pod": true,
              "service": true,
              "container": true,
              "cluster": true,
              "owner": true,
              "prometheus": true,
              "receive": true,
              "tenant_id": true
            },
            "renameByName": {
              "fqdn": "Record",
              "type": "Type",
              "content": "Target / Content",
              "ttl": "TTL",
              "proxied": "Proxied",
              "managed": "Managed"
            },
            "indexByName": {
              "fqdn": 0,
              "type": 1,
              "content": 2,
              "ttl": 3,
              "proxied": 4,
              "managed": 5
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": "",
            "sort": [
              {
                "field": "Managed",
                "desc": true
              },
              {
                "field": "Record"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true,
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Managed"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "true": {
                        "text": "yes",
                        "color": "green",
                        "index": 0
                      },
                      "false": {
                        "text": "\u2014",
                        "color": "text",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Proxied"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "true": {
                        "text": "\u2601 proxied",
                        "color": "orange",
                        "index": 0
                      },
                      "false": {
                        "text": "dns-only",
                        "color": "text",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "Live composition of the records external-dns owns in the Cloudflare registry, by type. A and AAAA come from dedicated metrics; 'CNAME / TXT / other' is the remainder of the total endpoint count (external-dns only exports per-type gauges for A and AAAA). TXT records are the ownership markers external-dns writes for every record it manages.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Total endpoints"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 12,
        "w": 6,
        "x": 18,
        "y": 6
      },
      "id": 10,
      "options": {
        "displayMode": "gradient",
        "maxVizHeight": 300,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "left",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "valueMode": "color"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
        "expr": "max(external_dns_registry_records{job=~\"$instance\",record_type=\"a\"})",
          "legendFormat": "A records",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
        "expr": "max(external_dns_registry_records{job=~\"$instance\",record_type=\"aaaa\"})",
          "legendFormat": "AAAA records",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
        "expr": "sum(external_dns_registry_records{job=~\"$instance\",record_type!~\"a|aaaa\"})",
          "legendFormat": "CNAME / TXT / other",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "max(external_dns_registry_endpoints_total{job=~\"$instance\"})",
          "legendFormat": "Total endpoints",
          "refId": "D"
        }
      ],
      "title": "Managed Records by Type",
      "type": "bargauge"
    },
    {
      "collapsed": false,
