    },
    {
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "description": "Top blocked (advertising/tracking) domains, summed across instances.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "custom": {"align": "auto", "filterable": true}, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}]}, "unit": "short"}},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 22},
      "id": 14,
