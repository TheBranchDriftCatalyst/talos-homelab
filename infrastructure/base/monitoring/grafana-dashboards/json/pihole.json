    {
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "description": "Upstream forward destinations by query volume, summed across instances.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "custom": {"align": "auto", "filterable": true}, "thresholds": {"mode": "absolute", "steps": [{"color": "purple", "value": null}]}, "unit": "short"}},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 31},
      "id": 16,
      "options": {"showHeader": true, "sortBy": [{"desc": true, "displayName": "Count"}]},
      "targets": [{"datasource": {"type": "prometheus", "uid": "mimir"}, "expr": "topk(15, sum by (destination, destination_name) (pihole_forward_destinations))", "format": "table", "instant": true, "legendFormat": "{{destination}}"}],
