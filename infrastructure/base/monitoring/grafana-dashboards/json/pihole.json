    {
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "description": "Cluster-wide daily counters over time. These are today's running totals (reset at midnight), so the lines climb through the day and drop at the day boundary.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"axisPlacement": "auto", "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "showPoints": "never", "spanNulls": true}, "unit": "short"}},
