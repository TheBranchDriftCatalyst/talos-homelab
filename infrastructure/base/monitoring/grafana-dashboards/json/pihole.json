      "options": {"showHeader": true, "sortBy": [{"desc": true, "displayName": "Count"}]},
      "targets": [{"datasource": {"type": "prometheus", "uid": "mimir"}, "expr": "topk(15, sum by (source, source_name) (pihole_top_sources))", "format": "table", "instant": true, "legendFormat": "{{source}}"}],
