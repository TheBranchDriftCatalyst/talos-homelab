      "targets": [{"datasource": {"type": "prometheus", "uid": "mimir"}, "expr": "topk(15, sum by (domain) (pihole_top_ads))", "format": "table", "instant": true, "legendFormat": "{{domain}}"}],
      "title": "Top Blocked Domains",
      "transformations": [
        {"id": "organize", "options": {"excludeByName": {"Time": true, "__name__": true, "hostname": true, "instance": true, "job": true, "namespace": true, "pod": true}, "renameByName": {"Value": "Count", "domain": "Domain"}}}
      ],
      "type": "table"
    },
    {
      "datasource": {"type": "prometheus", "uid": "mimir"},
