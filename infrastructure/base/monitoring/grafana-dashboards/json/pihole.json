      "options": {"showHeader": true, "sortBy": [{"desc": true, "displayName": "Count"}]},
      "targets": [{"datasource": {"type": "prometheus", "uid": "mimir"}, "expr": "topk(15, sum by (domain) (pihole_top_queries))", "format": "table", "instant": true, "legendFormat": "{{domain}}"}],
      "title": "Top Permitted Domains",
      "transformations": [
