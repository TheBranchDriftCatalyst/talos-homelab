      "options": {"legend": {"displayMode": "table", "placement": "right", "showLegend": true, "values": ["value", "percent"]}, "pieType": "donut", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "tooltip": {"mode": "single", "sort": "desc"}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "mimir"}, "expr": "sum by (type) (pihole_reply)", "legendFormat": "{{type}}"}],
      "title": "Reply Types (aggregate)",
      "type": "piechart"
    },
    {
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "description": "How queries were resolved cluster-wide: blocked vs served from cache vs forwarded upstream.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "unit": "short"}},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 13},
      "id": 12,
      "options": {"legend": {"displayMode": "table", "placement": "right", "showLegend": true, "values": ["value", "percent"]}, "pieType": "donut", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "tooltip": {"mode": "single", "sort": "desc"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "mimir"}, "expr": "sum(pihole_ads_blocked_today)", "legendFormat": "Blocked"},
        {"datasource": {"type": "prometheus", "uid": "mimir"}, "expr": "sum(pihole_queries_cached)", "legendFormat": "Cached"},
        {"datasource": {"type": "prometheus", "uid": "mimir"}, "expr": "sum(pihole_queries_forwarded)", "legendFormat": "Forwarded"}
      ],
