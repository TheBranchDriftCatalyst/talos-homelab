  "description": "Pi-hole cluster-aggregate DNS / ad-blocking dashboard. Sums stats across all 5 HA Pi-hole instances (one pod per node, single VIP, externalTrafficPolicy Local so one instance actively serves at a time). Metrics from the ekofr/pihole-exporter v6 sidecar via the pihole PodMonitor. Per-instance breakout uses the `pod` label (the exporter's own `hostname` label is identical on every pod).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 100,
      "panels": [],
      "title": "Cluster Aggregate (all instances)",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "description": "Total DNS queries today, summed across every Pi-hole instance. Because only the active instance serves the VIP, this is effectively the cluster-wide query volume.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}, "unit": "short"}},
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 1},
      "id": 1,
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "mimir"}, "expr": "sum(pihole_dns_queries_today)", "legendFormat": "Queries"}],
      "title": "Total DNS Queries (today)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "description": "Total ads/domains blocked today, summed across all instances.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}]}, "unit": "short"}},
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 1},
      "id": 2,
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "mimir"}, "expr": "sum(pihole_ads_blocked_today)", "legendFormat": "Blocked"}],
      "title": "Total Ads Blocked (today)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "description": "Block percentage computed from the SUMMED counters (sum(blocked)/sum(queries)), not averaged across instances — averaging would be skewed by idle instances reporting 0.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 40}]}, "unit": "percent", "min": 0, "max": 100}},
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 1},
      "id": 3,
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "mimir"}, "expr": "sum(pihole_ads_blocked_today) / clamp_min(sum(pihole_dns_queries_today), 1) * 100", "legendFormat": "Block %"}],
      "title": "Block % (aggregate)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "description": "DNS queries answered from local cache, summed across instances.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "unit": "short"}},
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 1},
      "id": 4,
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "mimir"}, "expr": "sum(pihole_queries_cached)", "legendFormat": "Cached"}],
      "title": "Queries Cached (today)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "description": "DNS queries forwarded to upstream resolvers, summed across instances.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "purple", "value": null}]}, "unit": "short"}},
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 1},
      "id": 5,
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "mimir"}, "expr": "sum(pihole_queries_forwarded)", "legendFormat": "Forwarded"}],
      "title": "Queries Forwarded (today)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "description": "Size of the blocklist (gravity domains). Uses max() not sum() — every instance loads the same blocklist, so summing would multiply by the replica count.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}, "unit": "short"}},
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 1},
      "id": 6,
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "mimir"}, "expr": "max(pihole_domains_being_blocked)", "legendFormat": "Blocklist Size"}],
      "title": "Domains on Blocklist",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5},
      "id": 101,
      "panels": [],
      "title": "Instance Health & Activity",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "description": "Number of Pi-hole instances currently reporting metrics (one exporter series per running pod). Expected: 5 (one per node). Below 5 = an instance is down or not being scraped.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 4}, {"color": "green", "value": 5}]}, "unit": "none"}},
      "gridPos": {"h": 6, "w": 4, "x": 0, "y": 6},
      "id": 7,
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value_and_name"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "mimir"}, "expr": "count(pihole_domains_being_blocked)", "legendFormat": "Instances Up"}],
      "title": "Instances Reporting",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "description": "Unique clients seen. Uses max() across instances (client sets overlap; the active instance sees them all) — summing would double-count.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}, "unit": "short"}},
      "gridPos": {"h": 6, "w": 4, "x": 4, "y": 6},
      "id": 8,
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "mimir"}, "expr": "max(pihole_unique_clients)", "legendFormat": "Unique Clients"}],
      "title": "Unique Clients (active)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "description": "Which instance is actively serving DNS. With externalTrafficPolicy Local + single VIP, the node holding the L2 lease serves all traffic — its pod shows a much higher query count today; idle instances sit near zero.",
      "fieldConfig": {"defaults": {"color": {"mode": "continuous-BlPu"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "unit": "short"}},
      "gridPos": {"h": 6, "w": 16, "x": 8, "y": 6},
      "id": 9,
      "options": {"displayMode": "gradient", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "showUnfilled": true},
      "targets": [{"datasource": {"type": "prometheus", "uid": "mimir"}, "expr": "sum by (pod) (pihole_dns_queries_today)", "legendFormat": "{{pod}}"}],
      "title": "Active Instance — Queries Served Today (by pod)",
      "type": "bargauge"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 12},
      "id": 102,
      "panels": [],
      "title": "Query Composition",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "description": "Query types (A, AAAA, PTR, ...) summed across all instances.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "unit": "short"}},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 13},
      "id": 10,
      "options": {"legend": {"displayMode": "table", "placement": "right", "showLegend": true, "values": ["value", "percent"]}, "pieType": "donut", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "tooltip": {"mode": "single", "sort": "desc"}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "mimir"}, "expr": "sum by (type) (pihole_querytypes)", "legendFormat": "{{type}}"}],
      "title": "Query Types (aggregate)",
