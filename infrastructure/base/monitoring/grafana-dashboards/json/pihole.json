    },
    {
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "description": "Top permitted (allowed) domains, summed across instances.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "custom": {"align": "auto", "filterable": true}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "unit": "short"}},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 22},
