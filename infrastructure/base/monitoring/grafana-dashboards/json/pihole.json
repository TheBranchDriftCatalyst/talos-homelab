      "transformations": [
        {"id": "organize", "options": {"excludeByName": {"Time": true, "__name__": true, "hostname": true, "instance": true, "job": true, "namespace": true, "pod": true}, "renameByName": {"Value": "Count", "destination": "Destination", "destination_name": "Name"}}}
