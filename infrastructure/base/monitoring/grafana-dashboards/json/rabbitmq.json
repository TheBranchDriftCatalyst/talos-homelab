{
  "uid": "rabbitmq-messaging",
  "title": "RabbitMQ Messaging",
  "tags": ["messaging", "rabbitmq", "amqp", "queue"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "annotations": { "list": [] },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "mimir" },
        "query": { "query": "label_values(rabbitmq_build_info, namespace)", "refId": "StandardVariableQuery" },
        "regex": "",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "pod",
        "label": "Node",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "mimir" },
        "query": { "query": "label_values(rabbitmq_build_info{namespace=~\"$namespace\"}, pod)", "refId": "StandardVariableQuery" },
        "regex": "",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    { "id": 1, "type": "row", "title": "Cluster Overview", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },

    {
      "id": 2, "type": "stat", "title": "Nodes up",
      "description": "RabbitMQ nodes exporting metrics (rabbitmq_build_info present).",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "count(count by (namespace, pod) (rabbitmq_build_info{namespace=~\"$namespace\", pod=~\"$pod\"}))" } ]
    },
    {
      "id": 3, "type": "stat", "title": "Ready messages",
      "description": "Messages ready for delivery (queued, waiting for a consumer).",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "textMode": "value" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "sum(max by (namespace, pod) (rabbitmq_queue_messages_ready{namespace=~\"$namespace\", pod=~\"$pod\"}))" } ]
    },
    {
      "id": 4, "type": "stat", "title": "Unacked messages",
      "description": "Messages delivered to a consumer but not yet acknowledged.",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "orange" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "textMode": "value" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "sum(max by (namespace, pod) (rabbitmq_queue_messages_unacked{namespace=~\"$namespace\", pod=~\"$pod\"}))" } ]
    },
    {
      "id": 5, "type": "stat", "title": "Queues",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "area", "textMode": "value" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "sum(max by (namespace, pod) (rabbitmq_queues{namespace=~\"$namespace\", pod=~\"$pod\"}))" } ]
    },
    {
      "id": 6, "type": "stat", "title": "Consumers",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "textMode": "value" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "sum(max by (namespace, pod) (rabbitmq_consumers{namespace=~\"$namespace\", pod=~\"$pod\"}))" } ]
    },
    {
      "id": 7, "type": "stat", "title": "Connections",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "area", "textMode": "value" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "sum(max by (namespace, pod) (rabbitmq_connections{namespace=~\"$namespace\", pod=~\"$pod\"}))" } ]
    },

    {
      "id": 8, "type": "table", "title": "Nodes",
      "description": "One row per RabbitMQ node: RabbitMQ + Erlang version (build info), resident memory, open vs max file descriptors, disk space available.",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 5 },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Memory" }, "properties": [ { "id": "unit", "value": "bytes" } ] },
          { "matcher": { "id": "byName", "options": "Disk Avail" }, "properties": [ { "id": "unit", "value": "bytes" } ] }
        ]
      },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false } },
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true, "container": true, "endpoint": true, "cluster": true, "service": true, "prometheus_client": true, "Value #Info": true }, "renameByName": { "namespace": "Namespace", "pod": "Node", "rabbitmq_version": "RabbitMQ", "erlang_version": "Erlang", "Value #Mem": "Memory", "Value #Fd": "FDs Open", "Value #FdMax": "FDs Max", "Value #Disk": "Disk Avail" } } }
      ],
      "targets": [
        { "refId": "Info", "format": "table", "instant": true, "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "max by (namespace, pod, rabbitmq_version, erlang_version) (rabbitmq_build_info{namespace=~\"$namespace\", pod=~\"$pod\"})" },
        { "refId": "Mem", "format": "table", "instant": true, "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "max by (namespace, pod) (rabbitmq_process_resident_memory_bytes{namespace=~\"$namespace\", pod=~\"$pod\"})" },
        { "refId": "Fd", "format": "table", "instant": true, "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "max by (namespace, pod) (rabbitmq_process_open_fds{namespace=~\"$namespace\", pod=~\"$pod\"})" },
        { "refId": "FdMax", "format": "table", "instant": true, "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "max by (namespace, pod) (rabbitmq_process_max_fds{namespace=~\"$namespace\", pod=~\"$pod\"})" },
        { "refId": "Disk", "format": "table", "instant": true, "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "max by (namespace, pod) (rabbitmq_disk_space_available_bytes{namespace=~\"$namespace\", pod=~\"$pod\"})" }
      ]
    },

    { "id": 10, "type": "row", "title": "Queues & Messages", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 } },

    {
      "id": 11, "type": "timeseries", "title": "Queue depth — ready vs unacked",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 20, "stacking": { "mode": "normal" }, "showPoints": "never" } }, "overrides": [ { "matcher": { "id": "byRegexp", "options": "/unacked/" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] } ] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "legendFormat": "{{pod}} ready", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "max by (namespace, pod) (rabbitmq_queue_messages_ready{namespace=~\"$namespace\", pod=~\"$pod\"})" },
        { "refId": "B", "legendFormat": "{{pod}} unacked", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "max by (namespace, pod) (rabbitmq_queue_messages_unacked{namespace=~\"$namespace\", pod=~\"$pod\"})" }
      ]
    },
    {
      "id": 12, "type": "timeseries", "title": "Total messages & queues",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" } }, "overrides": [ { "matcher": { "id": "byName", "options": "queues" }, "properties": [ { "id": "custom.axisPlacement", "value": "right" }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "purple" } } ] } ] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "legendFormat": "total messages", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "sum(max by (namespace, pod) (rabbitmq_queue_messages{namespace=~\"$namespace\", pod=~\"$pod\"}))" },
        { "refId": "B", "legendFormat": "queues", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "sum(max by (namespace, pod) (rabbitmq_queues{namespace=~\"$namespace\", pod=~\"$pod\"}))" }
      ]
    },

    { "id": 20, "type": "row", "title": "Throughput", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 } },

    {
      "id": 21, "type": "timeseries", "title": "Message rates — publish / deliver / ack [5m]",
      "description": "Global aggregated message counters from the rabbitmq_prometheus plugin. received = published INTO the broker; delivered = handed to consumers; acknowledged = confirmed by consumers.",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "legendFormat": "{{pod}} published", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "max by (namespace, pod) (rate(rabbitmq_global_messages_received_total{namespace=~\"$namespace\", pod=~\"$pod\"}[5m]))" },
        { "refId": "B", "legendFormat": "{{pod}} delivered", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "max by (namespace, pod) (rate(rabbitmq_global_messages_delivered_total{namespace=~\"$namespace\", pod=~\"$pod\"}[5m]))" },
        { "refId": "C", "legendFormat": "{{pod}} acked", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "max by (namespace, pod) (rate(rabbitmq_global_messages_acknowledged_total{namespace=~\"$namespace\", pod=~\"$pod\"}[5m]))" }
      ]
    },
    {
      "id": 22, "type": "timeseries", "title": "Redelivered & unroutable [5m]",
      "description": "Redelivered = messages re-queued and delivered again (consumer nacks / cancels); unroutable/dropped = published with no matching queue.",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" } }, "overrides": [ { "matcher": { "id": "byRegexp", "options": "/unroutable|dropped/" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] } ] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "legendFormat": "{{pod}} redelivered", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "max by (namespace, pod) (rate(rabbitmq_global_messages_redelivered_total{namespace=~\"$namespace\", pod=~\"$pod\"}[5m]))" },
        { "refId": "B", "legendFormat": "{{pod}} unroutable dropped", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "max by (namespace, pod) (rate(rabbitmq_global_messages_unroutable_dropped_total{namespace=~\"$namespace\", pod=~\"$pod\"}[5m]))" }
      ]
    },
    {
      "id": 23, "type": "timeseries", "title": "Connections & channels",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 20, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "legendFormat": "{{pod}} connections", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "max by (namespace, pod) (rabbitmq_connections{namespace=~\"$namespace\", pod=~\"$pod\"})" },
        { "refId": "B", "legendFormat": "{{pod}} channels", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "max by (namespace, pod) (rabbitmq_channels{namespace=~\"$namespace\", pod=~\"$pod\"})" }
      ]
    },
    {
      "id": 24, "type": "timeseries", "title": "Consumers",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 31 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "legendFormat": "{{pod}}", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "max by (namespace, pod) (rabbitmq_consumers{namespace=~\"$namespace\", pod=~\"$pod\"})" } ]
    },

    { "id": 30, "type": "row", "title": "Node Health & Alarms", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 39 } },

    {
      "id": 31, "type": "timeseries", "title": "Resident memory vs high watermark",
      "description": "Erlang VM resident memory vs the configured memory alarm high-watermark. Crossing the watermark blocks publishers.",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 40 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" } }, "overrides": [ { "matcher": { "id": "byRegexp", "options": "/watermark|limit/" }, "properties": [ { "id": "custom.lineStyle", "value": { "dash": [8, 4], "fill": "dash" } }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] } ] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "legendFormat": "{{pod}} used", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "max by (namespace, pod) (rabbitmq_process_resident_memory_bytes{namespace=~\"$namespace\", pod=~\"$pod\"})" },
        { "refId": "B", "legendFormat": "{{pod}} watermark", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "max by (namespace, pod) (rabbitmq_resident_memory_limit_bytes{namespace=~\"$namespace\", pod=~\"$pod\"})" }
      ]
    },
    {
      "id": 32, "type": "timeseries", "title": "Disk space available vs limit",
      "description": "Free disk space vs the free-disk alarm limit. Falling below the limit blocks publishers.",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 40 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" } }, "overrides": [ { "matcher": { "id": "byRegexp", "options": "/limit/" }, "properties": [ { "id": "custom.lineStyle", "value": { "dash": [8, 4], "fill": "dash" } }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] } ] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "legendFormat": "{{pod}} available", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "max by (namespace, pod) (rabbitmq_disk_space_available_bytes{namespace=~\"$namespace\", pod=~\"$pod\"})" },
        { "refId": "B", "legendFormat": "{{pod}} limit", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "max by (namespace, pod) (rabbitmq_disk_space_available_limit_bytes{namespace=~\"$namespace\", pod=~\"$pod\"})" }
      ]
    },
    {
      "id": 33, "type": "timeseries", "title": "File descriptors — open vs max",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 40 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" } }, "overrides": [ { "matcher": { "id": "byRegexp", "options": "/max/" }, "properties": [ { "id": "custom.lineStyle", "value": { "dash": [8, 4], "fill": "dash" } }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] } ] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "legendFormat": "{{pod}} open", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "max by (namespace, pod) (rabbitmq_process_open_fds{namespace=~\"$namespace\", pod=~\"$pod\"})" },
        { "refId": "B", "legendFormat": "{{pod}} max", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "max by (namespace, pod) (rabbitmq_process_max_fds{namespace=~\"$namespace\", pod=~\"$pod\"})" }
      ]
    },
    {
      "id": 34, "type": "stat", "title": "Active resource alarms (0 = OK)",
      "description": "Sum of memory / free-disk / file-descriptor watermark alarms across selected nodes. Any non-zero value means publishers are (or will be) blocked on that node.",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 48 },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" },
      "targets": [
        { "refId": "A", "legendFormat": "memory", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "sum(rabbitmq_alarms_memory_used_watermark{namespace=~\"$namespace\", pod=~\"$pod\"})" },
        { "refId": "B", "legendFormat": "free disk", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "sum(rabbitmq_alarms_free_disk_space_watermark{namespace=~\"$namespace\", pod=~\"$pod\"})" },
        { "refId": "C", "legendFormat": "file descriptor", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "sum(rabbitmq_alarms_file_descriptor_limit{namespace=~\"$namespace\", pod=~\"$pod\"})" }
      ]
    }
  ]
}
