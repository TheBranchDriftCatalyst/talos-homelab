        "textMode": "value_and_name"
      },
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "mimir"}, "expr": "count(probe_success{instance=~\"$instance\"} == 0)", "legendFormat": "Targets Down"}
      ],
      "title": "Targets Down",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 6},
      "id": 101,
      "panels": [],
      "title": "Endpoint Status",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "description": "Per-endpoint current status. Status column is colored green (1 = up) / red (0 = down). HTTP status code and last probe duration shown per instance. Note: several blackbox modules report an HTTP status of 0 even when the probe succeeds (TCP-level success); trust the Status column (probe_success) as the source of truth.",
      "fieldConfig": {
        "defaults": {
          "custom": {"align": "auto", "cellOptions": {"type": "auto"}, "inspect": false},
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Status"},
            "properties": [
              {"id": "custom.cellOptions", "value": {"type": "color-background"}},
              {"id": "color", "value": {"mode": "thresholds"}},
              {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}},
              {"id": "mappings", "value": [{"type": "value", "options": {"0": {"text": "DOWN", "index": 0}, "1": {"text": "UP", "index": 1}}}]},
              {"id": "custom.width", "value": 110}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "HTTP Status"},
            "properties": [{"id": "custom.width", "value": 120}]
          },
          {
            "matcher": {"id": "byName", "options": "Probe Duration"},
            "properties": [{"id": "unit", "value": "s"}, {"id": "decimals", "value": 3}]
          },
          {
            "matcher": {"id": "byName", "options": "Endpoint"},
            "properties": [{"id": "custom.width", "value": 420}]
          }
        ]
      },
      "gridPos": {"h": 11, "w": 24, "x": 0, "y": 7},
      "id": 4,
      "options": {
        "showHeader": true,
        "sortBy": [{"displayName": "Status", "desc": false}]
      },
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "mimir"}, "expr": "probe_success{instance=~\"$instance\"}", "format": "table", "instant": true, "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "mimir"}, "expr": "probe_http_status_code{instance=~\"$instance\"}", "format": "table", "instant": true, "refId": "B"},
        {"datasource": {"type": "prometheus", "uid": "mimir"}, "expr": "probe_duration_seconds{instance=~\"$instance\"}", "format": "table", "instant": true, "refId": "C"}
      ],
      "title": "Endpoint status",
      "transformations": [
        {
          "id": "joinByField",
          "options": {"byField": "instance", "mode": "outer"}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true, "Time 1": true, "Time 2": true, "Time 3": true,
              "__name__": true, "__name__ 1": true, "__name__ 2": true, "__name__ 3": true,
              "cluster": true, "cluster 1": true, "cluster 2": true, "cluster 3": true,
              "container": true, "container 1": true, "container 2": true, "container 3": true,
              "endpoint": true, "endpoint 1": true, "endpoint 2": true, "endpoint 3": true,
              "namespace": true, "namespace 1": true, "namespace 2": true, "namespace 3": true,
              "pod": true, "pod 1": true, "pod 2": true, "pod 3": true,
              "service": true, "service 1": true, "service 2": true, "service 3": true,
              "job 1": true, "job 2": true, "job 3": true,
              "target 1": true, "target 2": true, "target 3": true
            },
            "indexByName": {},
            "renameByName": {
              "instance": "Endpoint",
              "job": "Job",
              "target": "Target",
              "Value #A": "Status",
              "Value #B": "HTTP Status",
              "Value #C": "Probe Duration"
            }
          }
        }
      ],
      "type": "table"
    },
    {
