  "description": "Uptime / SLO overview driven by blackbox-exporter probes. Grounded 2026-08-08 against Mimir: 13 probe targets across two jobs (prometheus-blackbox-exporter with full-URL instance labels, blackbox-probes with friendly-name instance labels). All series carry probe_success, probe_http_status_code and probe_duration_seconds. probe_ssl_earliest_cert_expiry returned NO data (every target is plain HTTP), so no TLS-expiry panel is included. Templated on $instance (label_values(probe_success, instance), multi + All).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 100,
      "panels": [],
      "title": "Availability Summary",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "description": "Overall availability across all probe targets (mean of probe_success * 100). 100% = every probed endpoint is up.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 90}, {"color": "yellow", "value": 99}, {"color": "green", "value": 99.9}]},
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 2
        }
      },
      "gridPos": {"h": 5, "w": 8, "x": 0, "y": 1},
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value_and_name"
      },
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "mimir"}, "expr": "avg(probe_success{instance=~\"$instance\"}) * 100", "legendFormat": "Overall Up %"}
      ],
      "title": "Overall Availability",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "description": "Number of probe targets currently reporting up (probe_success == 1).",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]},
          "unit": "none"
        }
      },
      "gridPos": {"h": 5, "w": 8, "x": 8, "y": 1},
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value_and_name"
      },
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "mimir"}, "expr": "count(probe_success{instance=~\"$instance\"} == 1)", "legendFormat": "Targets Up"}
      ],
      "title": "Targets Up",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "description": "Number of probe targets currently reporting down (probe_success == 0). Any non-zero value is actionable.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]},
          "unit": "none",
          "noValue": "0"
        }
      },
      "gridPos": {"h": 5, "w": 8, "x": 16, "y": 1},
      "id": 3,
      "options": {
