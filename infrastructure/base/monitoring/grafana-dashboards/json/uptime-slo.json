        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "mimir"}, "expr": "probe_duration_seconds{instance=~\"$instance\"}", "legendFormat": "{{instance}}"}
      ],
      "title": "Probe Duration per Endpoint",
      "type": "timeseries"
    }
