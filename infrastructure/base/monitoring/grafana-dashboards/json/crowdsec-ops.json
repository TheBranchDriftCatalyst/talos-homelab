    {
      "id": 17,
      "title": "Scenario triggers / second · includes simulation",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 12,
        "h": 8
      },
      "description": "Overflows indicate detection activity. Profiles, allowlists, and simulation determine whether a decision follows.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No data",
          "decimals": 2
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (rate(cs_bucket_overflowed_total{job=\"crowdsec/crowdsec\",name=~\"$scenario\"}[$__rate_interval]))",
          "legendFormat": "{{name}}",
