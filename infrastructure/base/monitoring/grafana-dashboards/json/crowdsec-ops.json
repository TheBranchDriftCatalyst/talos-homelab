    },
    {
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "description": "Currently-active decisions (bans/captchas) held by the LAPI, summed across all origins (crowdsec local scenarios, CAPI community blocklist, subscribed lists, manual cscli). Metric: cs_active_decisions (gauge; labels reason, origin, action). Empty until the engine is scraped; large numbers usually mean the CAPI community blocklist is enrolled.",
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "red"}, "unit": "short"}},
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 1},
      "id": 1,
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "mimir"}, "expr": "sum(cs_active_decisions{origin=~\"$origin\"})", "legendFormat": "Active"}],
      "title": "Active Decisions (bans)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "description": "Locally-generated decisions in the last 24h, proxied by bucket overflows (each scenario overflow raises one alert → one decision). Metric: increase(cs_bucket_overflowed_total[24h]). NOTE: this counts only LOCAL scenario decisions — CAPI/list-sourced decisions bump the active-decisions gauge without a local overflow, so this undercounts total additions.",
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "orange"}, "unit": "short"}},
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 1},
      "id": 2,
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value"},
