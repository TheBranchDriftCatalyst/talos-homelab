      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "value": true,
              "decision_id": true,
              "Value": true
            },
            "renameByName": {
              "value": "IP / range",
              "decision_id": "Decision ID",
              "Value": "Remaining"
            },
            "indexByName": {
              "value": 0,
              "decision_id": 1,
              "Value": 2
            }
          }
        }
      ]
    },
