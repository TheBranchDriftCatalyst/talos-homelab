      },
      "targets": [],
      "collapsed": false,
      "panels": []
    },
    {
      "id": 10,
      "title": "Active local decisions · expires at",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 16,
        "h": 9
      },
      "description": "Current read-only LAPI bouncer inventory; simulated decisions never appear. Up to 1,000 newest local/manual decisions. Expiry is derived from the remaining duration, not issue time. This table is always current regardless of dashboard time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Expires at"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "IP / range"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "CrowdSec IP intelligence",
                    "url": "https://app.crowdsec.net/cti/${__value.raw}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(max by (decision_id,value,scope,action,origin,scenario) (crowdsec_local_decision_expires_timestamp_seconds{job=\"crowdsec/crowdsec-decisions\",origin=~\"$origin\"}) > time()) * 1000",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "value": true,
              "scope": true,
              "action": true,
              "scenario": true,
              "origin": true,
              "decision_id": true,
              "Value": true
            },
            "renameByName": {
              "value": "IP / range",
              "scope": "Scope",
              "action": "Action",
              "scenario": "Reason",
              "origin": "Origin",
              "decision_id": "Decision ID",
              "Value": "Expires at"
            },
            "indexByName": {
              "value": 0,
              "scope": 1,
              "action": 2,
              "scenario": 3,
              "origin": 4,
              "decision_id": 5,
              "Value": 6
            }
          }
        }
      ]
    },
    {
      "id": 11,
      "title": "Time remaining · local decisions",
      "type": "table",
      "gridPos": {
        "x": 16,
        "y": 9,
        "w": 8,
        "h": 9
      },
      "description": "Same current decisions as the expiry table. Bouncer refresh can delay enforcement or removal. No inference about when the ban was issued.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Remaining"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(max by (decision_id,value,scope,action,origin,scenario) (crowdsec_local_decision_expires_timestamp_seconds{job=\"crowdsec/crowdsec-decisions\",origin=~\"$origin\"}) > time()) - time()",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "instant": true,
          "range": false,
          "format": "table"
