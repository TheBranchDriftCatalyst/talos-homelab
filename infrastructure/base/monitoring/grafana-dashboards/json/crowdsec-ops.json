    {
      "id": 2,
      "title": "Local enforced decisions",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "description": "Local/manual decisions currently eligible for enforcement. Excludes simulation and community lists. A decision can cover a range; this is not a unique-IP or blocked-request count.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(crowdsec_local_decisions_count{job=\"crowdsec/crowdsec-decisions\"})",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "Community / imported bans",
      "type": "stat",
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "description": "Shared LAPI database gauges deduplicated across replicas. These bans can exist while local decision count is zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by (origin,reason,action) (cs_active_decisions{job=\"crowdsec/crowdsec\",origin!~\"crowdsec|cscli|cscli-import\",action=\"ban\"}))",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "instant": true,
          "range": false,
          "format": "time_series"
