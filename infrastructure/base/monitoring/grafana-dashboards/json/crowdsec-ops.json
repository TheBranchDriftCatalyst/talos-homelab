    {
      "id": 15,
      "title": "Decision history · observed and removed",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "description": "Observation history from the inventory poller, starting with this deployment. observed = first seen during polling; snapshot = already present when exporter started; removed = no longer returned by LAPI. These are observation times, not exact issuance or unblock times. No events is normal when decisions have not changed.",
      "datasource": {
        "type": "loki",
        "uid": "loki-v2"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki-v2"
          },
          "expr": "{namespace=\"crowdsec\",container=\"exporter\"} | json | event=~\"snapshot|observed|removed\" | line_format \"{{.event}} | {{.value}} | {{.action}} | {{.scenario}} | decision={{.decision_id}}\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    },
