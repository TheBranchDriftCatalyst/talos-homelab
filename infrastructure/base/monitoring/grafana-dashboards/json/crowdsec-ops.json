      "title": "Decisions Added (24h, local)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "description": "Local alerts raised in the last 24h (bucket overflows). Metric: increase(cs_bucket_overflowed_total[24h]). Locally, alerts ≈ decisions added; this stays empty until a scenario actually overflows (needs malicious traffic).",
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "yellow"}, "unit": "short"}},
