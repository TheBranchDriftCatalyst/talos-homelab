{
  "uid": "dragonfly-cache",
  "title": "Dragonfly Cache",
  "tags": ["db", "cache", "redis", "dragonfly"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "annotations": { "list": [] },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "mimir" },
        "query": { "query": "label_values(dragonfly_version, namespace)", "refId": "StandardVariableQuery" },
        "regex": "",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "pod",
        "label": "Instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "mimir" },
        "query": { "query": "label_values(dragonfly_version{namespace=~\"$namespace\"}, pod)", "refId": "StandardVariableQuery" },
        "regex": "",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    { "id": 1, "type": "row", "title": "Fleet Overview", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },

    {
      "id": 2, "type": "stat", "title": "Instances up",
      "description": "Number of scraped Dragonfly instances (any pod exporting dragonfly_version).",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "count(count by (namespace, pod) (dragonfly_version{namespace=~\"$namespace\", pod=~\"$pod\"}))" } ]
    },
    {
      "id": 3, "type": "stat", "title": "Total memory used",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "bytes", "color": { "mode": "fixed", "fixedColor": "purple" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "textMode": "value" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "sum(max by (namespace, pod) (dragonfly_memory_used_bytes{namespace=~\"$namespace\", pod=~\"$pod\"}))" } ]
    },
    {
      "id": 4, "type": "stat", "title": "Connected clients",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "area", "textMode": "value" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "sum(max by (namespace, pod) (dragonfly_connected_clients{namespace=~\"$namespace\", pod=~\"$pod\"}))" } ]
    },
    {
      "id": 5, "type": "stat", "title": "Fleet ops/sec",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "ops", "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "textMode": "value" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "sum(rate(dragonfly_commands_processed_total{namespace=~\"$namespace\", pod=~\"$pod\"}[$__rate_interval]))" } ]
    },
    {
      "id": 6, "type": "stat", "title": "Total keys",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "textMode": "value" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "sum(max by (namespace, pod, db) (dragonfly_db_keys{namespace=~\"$namespace\", pod=~\"$pod\"}))" } ]
    },
    {
      "id": 7, "type": "stat", "title": "Fleet hit ratio [5m]",
      "description": "keyspace_hits / (keyspace_hits + keyspace_misses) over the last 5m across selected instances.",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 0.8 }, { "color": "green", "value": 0.95 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "sum(rate(dragonfly_keyspace_hits_total{namespace=~\"$namespace\", pod=~\"$pod\"}[5m])) / (sum(rate(dragonfly_keyspace_hits_total{namespace=~\"$namespace\", pod=~\"$pod\"}[5m])) + sum(rate(dragonfly_keyspace_misses_total{namespace=~\"$namespace\", pod=~\"$pod\"}[5m])))" } ]
    },

    {
      "id": 8, "type": "table", "title": "Instances",
      "description": "One row per Dragonfly instance: version, uptime, connected clients, memory used vs max, total keys.",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 5 },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Uptime" }, "properties": [ { "id": "unit", "value": "s" } ] },
          { "matcher": { "id": "byName", "options": "Mem Used" }, "properties": [ { "id": "unit", "value": "bytes" } ] },
          { "matcher": { "id": "byName", "options": "Mem Max" }, "properties": [ { "id": "unit", "value": "bytes" } ] }
        ]
      },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false } },
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true, "container": true, "endpoint": true, "cluster": true, "service": true, "Value #Ver": true }, "renameByName": { "namespace": "Namespace", "pod": "Instance", "version": "Version", "Value #Up": "Uptime", "Value #Cli": "Clients", "Value #MemU": "Mem Used", "Value #MemM": "Mem Max", "Value #Keys": "Keys" } } }
      ],
      "targets": [
        { "refId": "Ver", "format": "table", "instant": true, "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "max by (namespace, pod, version) (dragonfly_version{namespace=~\"$namespace\", pod=~\"$pod\"})" },
        { "refId": "Up", "format": "table", "instant": true, "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "max by (namespace, pod) (dragonfly_uptime_in_seconds{namespace=~\"$namespace\", pod=~\"$pod\"})" },
        { "refId": "Cli", "format": "table", "instant": true, "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "max by (namespace, pod) (dragonfly_connected_clients{namespace=~\"$namespace\", pod=~\"$pod\"})" },
        { "refId": "MemU", "format": "table", "instant": true, "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "max by (namespace, pod) (dragonfly_memory_used_bytes{namespace=~\"$namespace\", pod=~\"$pod\"})" },
        { "refId": "MemM", "format": "table", "instant": true, "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "max by (namespace, pod) (dragonfly_memory_max_bytes{namespace=~\"$namespace\", pod=~\"$pod\"})" },
        { "refId": "Keys", "format": "table", "instant": true, "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "sum by (namespace, pod) (max by (namespace, pod, db) (dragonfly_db_keys{namespace=~\"$namespace\", pod=~\"$pod\"}))" }
      ]
    },

    { "id": 10, "type": "row", "title": "Memory", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 } },

    {
      "id": 11, "type": "timeseries", "title": "Memory used vs max (maxmemory)",
      "description": "Working-set memory vs the configured maxmemory (--maxmemory). Dashed line = max; approaching it triggers evictions.",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" } }, "overrides": [ { "matcher": { "id": "byRegexp", "options": "/max/" }, "properties": [ { "id": "custom.lineStyle", "value": { "dash": [8, 4], "fill": "dash" } }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] } ] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "legendFormat": "{{pod}} used", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "max by (namespace, pod) (dragonfly_memory_used_bytes{namespace=~\"$namespace\", pod=~\"$pod\"})" },
        { "refId": "B", "legendFormat": "{{pod}} rss", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "max by (namespace, pod) (dragonfly_used_memory_rss_bytes{namespace=~\"$namespace\", pod=~\"$pod\"})" },
        { "refId": "C", "legendFormat": "{{pod}} max", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "max by (namespace, pod) (dragonfly_memory_max_bytes{namespace=~\"$namespace\", pod=~\"$pod\"})" }
      ]
    },
    {
      "id": 12, "type": "gauge", "title": "Memory usage % of maxmemory",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 75 }, { "color": "red", "value": 90 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": false, "showThresholdMarkers": true },
      "targets": [ { "refId": "A", "legendFormat": "{{pod}}", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "100 * max by (namespace, pod) (dragonfly_memory_used_bytes{namespace=~\"$namespace\", pod=~\"$pod\"}) / max by (namespace, pod) (dragonfly_memory_max_bytes{namespace=~\"$namespace\", pod=~\"$pod\"} > 0)" } ]
    },
    {
      "id": 13, "type": "timeseries", "title": "Evicted & expired keys/sec [5m]",
      "description": "Rate of evictions (memory-pressure driven) and TTL expirations. Sustained evictions mean maxmemory is too small for the working set.",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" } }, "overrides": [ { "matcher": { "id": "byRegexp", "options": "/evicted/" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] } ] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "legendFormat": "{{pod}} evicted", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "max by (namespace, pod) (rate(dragonfly_evicted_keys_total{namespace=~\"$namespace\", pod=~\"$pod\"}[5m]))" },
        { "refId": "B", "legendFormat": "{{pod}} expired", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "max by (namespace, pod) (rate(dragonfly_expired_keys_total{namespace=~\"$namespace\", pod=~\"$pod\"}[5m]))" }
      ]
    },

    { "id": 20, "type": "row", "title": "Throughput & Clients", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 } },

    {
      "id": 21, "type": "timeseries", "title": "Commands processed/sec",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "legendFormat": "{{pod}}", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "max by (namespace, pod) (rate(dragonfly_commands_processed_total{namespace=~\"$namespace\", pod=~\"$pod\"}[$__rate_interval]))" } ]
    },
    {
      "id": 22, "type": "timeseries", "title": "Keyspace hits vs misses/sec [5m]",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" } }, "overrides": [ { "matcher": { "id": "byRegexp", "options": "/miss/" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] } ] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "legendFormat": "{{pod}} hits", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "max by (namespace, pod) (rate(dragonfly_keyspace_hits_total{namespace=~\"$namespace\", pod=~\"$pod\"}[5m]))" },
        { "refId": "B", "legendFormat": "{{pod}} misses", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "max by (namespace, pod) (rate(dragonfly_keyspace_misses_total{namespace=~\"$namespace\", pod=~\"$pod\"}[5m]))" }
      ]
    },
    {
      "id": 23, "type": "timeseries", "title": "Connected clients",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 20, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "legendFormat": "{{pod}} clients", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "max by (namespace, pod) (dragonfly_connected_clients{namespace=~\"$namespace\", pod=~\"$pod\"})" },
        { "refId": "B", "legendFormat": "{{pod}} blocked", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "max by (namespace, pod) (dragonfly_blocked_clients{namespace=~\"$namespace\", pod=~\"$pod\"})" }
      ]
    },
    {
      "id": 24, "type": "timeseries", "title": "Network I/O bytes/sec [5m]",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 31 },
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "legendFormat": "{{pod}} in", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "max by (namespace, pod) (rate(dragonfly_net_input_bytes_total{namespace=~\"$namespace\", pod=~\"$pod\"}[5m]))" },
        { "refId": "B", "legendFormat": "{{pod}} out", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "max by (namespace, pod) (rate(dragonfly_net_output_bytes_total{namespace=~\"$namespace\", pod=~\"$pod\"}[5m]))" }
      ]
    },

    { "id": 30, "type": "row", "title": "Keyspace", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 39 } },

    {
      "id": 31, "type": "timeseries", "title": "Keys per instance",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "legendFormat": "{{pod}}", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "sum by (namespace, pod) (max by (namespace, pod, db) (dragonfly_db_keys{namespace=~\"$namespace\", pod=~\"$pod\"}))" } ]
    },
    {
      "id": 32, "type": "timeseries", "title": "Memory used per instance",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "legendFormat": "{{pod}}", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "max by (namespace, pod) (dragonfly_memory_used_bytes{namespace=~\"$namespace\", pod=~\"$pod\"})" } ]
    }
  ]
}
