{
  "uid": "catalyst-k8s-dashboard",
  "title": "Catalyst K8s — Full System Ops",
  "tags": ["kubernetes", "catalyst", "ops", "cluster"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "annotations": { "list": [] },
  "templating": {
    "list": [
      {
        "name": "namespace", "label": "Namespace", "type": "query",
        "datasource": { "type": "prometheus", "uid": "mimir" },
        "query": { "query": "label_values(kube_pod_info{job=\"kube-state-metrics\"}, namespace)", "refId": "StandardVariableQuery" },
        "includeAll": true, "allValue": ".*", "multi": true, "refresh": 2, "sort": 1,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "node", "label": "Node", "type": "query",
        "datasource": { "type": "prometheus", "uid": "mimir" },
        "query": { "query": "label_values(kube_node_info{job=\"kube-state-metrics\"}, node)", "refId": "StandardVariableQuery" },
        "includeAll": true, "allValue": ".*", "multi": true, "refresh": 2, "sort": 1,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    { "id": 1, "type": "row", "title": "Cluster Health", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },

    { "id": 2, "type": "stat", "title": "Nodes Ready", "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 4, "w": 3, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "sum(kube_node_status_condition{job=\"kube-state-metrics\", condition=\"Ready\", status=\"true\"})" } ] },
    { "id": 3, "type": "stat", "title": "Nodes NotReady", "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 4, "w": 3, "x": 3, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "sum(kube_node_status_condition{job=\"kube-state-metrics\", condition=\"Ready\", status=\"false\"}) + sum(kube_node_status_condition{job=\"kube-state-metrics\", condition=\"Ready\", status=\"unknown\"})" } ] },
    { "id": 4, "type": "stat", "title": "Pods Running", "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 4, "w": 3, "x": 6, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "area", "textMode": "value" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "sum(kube_pod_status_phase{job=\"kube-state-metrics\", phase=\"Running\", namespace=~\"$namespace\"})" } ] },
    { "id": 5, "type": "stat", "title": "Pods Pending", "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 4, "w": 3, "x": 9, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "sum(kube_pod_status_phase{job=\"kube-state-metrics\", phase=\"Pending\", namespace=~\"$namespace\"})" } ] },
    { "id": 6, "type": "stat", "title": "Pods Failed", "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 4, "w": 3, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "sum(kube_pod_status_phase{job=\"kube-state-metrics\", phase=\"Failed\", namespace=~\"$namespace\"})" } ] },
    { "id": 7, "type": "stat", "title": "Container Restarts (1h)", "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 4, "w": 3, "x": 15, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 20 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "textMode": "value" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "sum(increase(kube_pod_container_status_restarts_total{job=\"kube-state-metrics\", namespace=~\"$namespace\"}[1h]))" } ] },
    { "id": 8, "type": "stat", "title": "CPU Committed", "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 4, "w": 3, "x": 18, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 80 }, { "color": "red", "value": 100 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "100 * sum(kube_pod_container_resource_requests{job=\"kube-state-metrics\", resource=\"cpu\"}) / sum(kube_node_status_allocatable{job=\"kube-state-metrics\", resource=\"cpu\"})" } ] },
    { "id": 9, "type": "stat", "title": "Memory Committed", "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 4, "w": 3, "x": 21, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 80 }, { "color": "red", "value": 100 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "100 * sum(kube_pod_container_resource_requests{job=\"kube-state-metrics\", resource=\"memory\"}) / sum(kube_node_status_allocatable{job=\"kube-state-metrics\", resource=\"memory\"})" } ] },

    { "id": 10, "type": "row", "title": "What's Broken", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 } },

    { "id": 11, "type": "table", "title": "Pods not Running", "datasource": { "type": "prometheus", "uid": "mimir" },
      "description": "Pods currently Pending / Failed / Unknown. Empty = all good.",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 6 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false }, "sortBy": [ { "displayName": "Namespace", "desc": false } ] },
      "transformations": [ { "id": "organize", "options": { "excludeByName": { "Time": true, "Value": true, "__name__": true, "job": true, "instance": true, "container": true, "endpoint": true, "cluster": true, "service": true, "uid": true, "pod_ip": true, "host_ip": true }, "renameByName": { "namespace": "Namespace", "pod": "Pod", "phase": "Phase" } } } ],
      "targets": [ { "refId": "A", "format": "table", "instant": true, "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "kube_pod_status_phase{job=\"kube-state-metrics\", phase=~\"Pending|Failed|Unknown\", namespace=~\"$namespace\"} > 0" } ] },
    { "id": 12, "type": "table", "title": "Top Container Restarts (1h)", "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "cellOptions": { "type": "color-text" } }, "thresholds": { "mode": "absolute", "steps": [ { "color": "yellow", "value": null }, { "color": "red", "value": 10 } ] } }, "overrides": [] },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false }, "sortBy": [ { "displayName": "Restarts", "desc": true } ] },
      "transformations": [ { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true, "endpoint": true, "cluster": true, "service": true, "uid": true }, "renameByName": { "namespace": "Namespace", "pod": "Pod", "container": "Container", "Value": "Restarts" } } } ],
      "targets": [ { "refId": "A", "format": "table", "instant": true, "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "topk(20, sum by (namespace, pod, container) (increase(kube_pod_container_status_restarts_total{job=\"kube-state-metrics\", namespace=~\"$namespace\"}[1h]))) > 0" } ] },
    { "id": 13, "type": "table", "title": "Unhealthy Workloads (deployments)", "datasource": { "type": "prometheus", "uid": "mimir" },
      "description": "Deployments where available replicas < desired.",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "cellOptions": { "type": "color-text" } }, "color": { "mode": "fixed", "fixedColor": "red" } }, "overrides": [] },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false }, "sortBy": [ { "displayName": "Missing", "desc": true } ] },
      "transformations": [ { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true, "endpoint": true, "cluster": true, "service": true }, "renameByName": { "namespace": "Namespace", "deployment": "Deployment", "Value": "Missing" } } } ],
      "targets": [ { "refId": "A", "format": "table", "instant": true, "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "(kube_deployment_spec_replicas{job=\"kube-state-metrics\", namespace=~\"$namespace\"} - kube_deployment_status_replicas_available{job=\"kube-state-metrics\", namespace=~\"$namespace\"}) > 0" } ] },

    { "id": 20, "type": "row", "title": "Capacity & Allocation", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 } },

    { "id": 21, "type": "timeseries", "title": "Cluster CPU — requests / limits / usage / allocatable", "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" } }, "overrides": [ { "matcher": { "id": "byName", "options": "allocatable" }, "properties": [ { "id": "custom.lineStyle", "value": { "dash": [8, 4], "fill": "dash" } }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] } ] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "legendFormat": "usage", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "sum(rate(container_cpu_usage_seconds_total{container!=\"\", namespace=~\"$namespace\"}[5m]))" },
        { "refId": "B", "legendFormat": "requests", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "sum(kube_pod_container_resource_requests{job=\"kube-state-metrics\", resource=\"cpu\", namespace=~\"$namespace\"})" },
        { "refId": "C", "legendFormat": "limits", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "sum(kube_pod_container_resource_limits{job=\"kube-state-metrics\", resource=\"cpu\", namespace=~\"$namespace\"})" },
        { "refId": "D", "legendFormat": "allocatable", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "sum(kube_node_status_allocatable{job=\"kube-state-metrics\", resource=\"cpu\", node=~\"$node\"})" }
      ] },
    { "id": 22, "type": "timeseries", "title": "Cluster Memory — requests / limits / usage / allocatable", "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" } }, "overrides": [ { "matcher": { "id": "byName", "options": "allocatable" }, "properties": [ { "id": "custom.lineStyle", "value": { "dash": [8, 4], "fill": "dash" } }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] } ] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "legendFormat": "usage", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "sum(container_memory_working_set_bytes{container!=\"\", namespace=~\"$namespace\"})" },
        { "refId": "B", "legendFormat": "requests", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "sum(kube_pod_container_resource_requests{job=\"kube-state-metrics\", resource=\"memory\", namespace=~\"$namespace\"})" },
        { "refId": "C", "legendFormat": "limits", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "sum(kube_pod_container_resource_limits{job=\"kube-state-metrics\", resource=\"memory\", namespace=~\"$namespace\"})" },
        { "refId": "D", "legendFormat": "allocatable", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "sum(kube_node_status_allocatable{job=\"kube-state-metrics\", resource=\"memory\", node=~\"$node\"})" }
      ] },
    { "id": 23, "type": "bargauge", "title": "CPU requests % of allocatable, per node", "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 23 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 80 }, { "color": "red", "value": 95 } ] } }, "overrides": [] },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "refId": "A", "legendFormat": "{{node}}", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "100 * sum by (node) (kube_pod_container_resource_requests{job=\"kube-state-metrics\", resource=\"cpu\", node=~\"$node\"}) / sum by (node) (kube_node_status_allocatable{job=\"kube-state-metrics\", resource=\"cpu\", node=~\"$node\"})" } ] },
    { "id": 24, "type": "bargauge", "title": "Memory requests % of allocatable, per node", "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 23 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 80 }, { "color": "red", "value": 95 } ] } }, "overrides": [] },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "refId": "A", "legendFormat": "{{node}}", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "100 * sum by (node) (kube_pod_container_resource_requests{job=\"kube-state-metrics\", resource=\"memory\", node=~\"$node\"}) / sum by (node) (kube_node_status_allocatable{job=\"kube-state-metrics\", resource=\"memory\", node=~\"$node\"})" } ] },
    { "id": 25, "type": "bargauge", "title": "Pods % of capacity, per node", "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 23 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 80 }, { "color": "red", "value": 95 } ] } }, "overrides": [] },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "refId": "A", "legendFormat": "{{node}}", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "100 * count by (node) (kube_pod_info{job=\"kube-state-metrics\", node=~\"$node\"}) / sum by (node) (kube_node_status_capacity{job=\"kube-state-metrics\", resource=\"pods\", node=~\"$node\"})" } ] },

    { "id": 30, "type": "row", "title": "Nodes", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 } },

    { "id": 31, "type": "table", "title": "Node Inventory", "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [
        { "matcher": { "id": "byName", "options": "Ready" }, "properties": [ { "id": "mappings", "value": [ { "type": "value", "options": { "1": { "text": "Ready", "color": "green", "index": 0 }, "0": { "text": "NotReady", "color": "red", "index": 1 } } } ] }, { "id": "custom.cellOptions", "value": { "type": "color-text" } } ] },
        { "matcher": { "id": "byName", "options": "CPU alloc" }, "properties": [ { "id": "unit", "value": "short" } ] },
        { "matcher": { "id": "byName", "options": "Mem alloc" }, "properties": [ { "id": "unit", "value": "bytes" } ] },
        { "matcher": { "id": "byRegexp", "options": "/%/" }, "properties": [ { "id": "unit", "value": "percent" }, { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient" } }, { "id": "max", "value": 100 } ] }
      ] },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false }, "sortBy": [ { "displayName": "Node", "desc": false } ] },
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true, "endpoint": true, "cluster": true, "service": true, "condition": true, "status": true }, "renameByName": { "node": "Node", "Value #Ready": "Ready", "Value #CPUa": "CPU alloc", "Value #CPUp": "CPU req %", "Value #MEMa": "Mem alloc", "Value #MEMp": "Mem req %", "Value #Pods": "Pods", "Value #PodP": "Pods %" } } }
      ],
      "targets": [
        { "refId": "Ready", "format": "table", "instant": true, "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "max by (node) (kube_node_status_condition{job=\"kube-state-metrics\", condition=\"Ready\", status=\"true\", node=~\"$node\"})" },
        { "refId": "CPUa", "format": "table", "instant": true, "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "sum by (node) (kube_node_status_allocatable{job=\"kube-state-metrics\", resource=\"cpu\", node=~\"$node\"})" },
        { "refId": "CPUp", "format": "table", "instant": true, "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "100 * sum by (node) (kube_pod_container_resource_requests{job=\"kube-state-metrics\", resource=\"cpu\", node=~\"$node\"}) / sum by (node) (kube_node_status_allocatable{job=\"kube-state-metrics\", resource=\"cpu\", node=~\"$node\"})" },
        { "refId": "MEMa", "format": "table", "instant": true, "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "sum by (node) (kube_node_status_allocatable{job=\"kube-state-metrics\", resource=\"memory\", node=~\"$node\"})" },
        { "refId": "MEMp", "format": "table", "instant": true, "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "100 * sum by (node) (kube_pod_container_resource_requests{job=\"kube-state-metrics\", resource=\"memory\", node=~\"$node\"}) / sum by (node) (kube_node_status_allocatable{job=\"kube-state-metrics\", resource=\"memory\", node=~\"$node\"})" },
        { "refId": "Pods", "format": "table", "instant": true, "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "count by (node) (kube_pod_info{job=\"kube-state-metrics\", node=~\"$node\"})" },
        { "refId": "PodP", "format": "table", "instant": true, "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "100 * count by (node) (kube_pod_info{job=\"kube-state-metrics\", node=~\"$node\"}) / sum by (node) (kube_node_status_capacity{job=\"kube-state-metrics\", resource=\"pods\", node=~\"$node\"})" }
      ] },

    { "id": 40, "type": "row", "title": "Top Consumers", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 41 } },

    { "id": 41, "type": "bargauge", "title": "Top 15 pods by CPU usage", "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 42 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "continuous-BlPu" } }, "overrides": [] },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "refId": "A", "legendFormat": "{{namespace}}/{{pod}}", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "topk(15, sum by (namespace, pod) (rate(container_cpu_usage_seconds_total{container!=\"\", namespace=~\"$namespace\"}[5m])))" } ] },
    { "id": 42, "type": "bargauge", "title": "Top 15 pods by Memory (working set)", "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 42 },
      "fieldConfig": { "defaults": { "unit": "bytes", "color": { "mode": "continuous-BlPu" } }, "overrides": [] },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "refId": "A", "legendFormat": "{{namespace}}/{{pod}}", "datasource": { "type": "prometheus", "uid": "mimir" }, "expr": "topk(15, sum by (namespace, pod) (container_memory_working_set_bytes{container!=\"\", namespace=~\"$namespace\"}))" } ] }
  ]
}
