{
  "uid": "kubevirt-vm-ops",
  "title": "KubeVirt VM Ops",
  "description": "KubeVirt VM operations: inventory (what runs where), virt params (vCPU/memory/machine type), and per-VM resource usage (CPU, memory, network, storage). Question-first ops view.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "tags": ["kubevirt", "vm", "virtualization", "ops"],
  "timezone": "",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "mimir" },
        "definition": "label_values(kubevirt_vmi_info, namespace)",
        "hide": 0,
        "includeAll": true,
        "allValue": ".*",
        "label": "Namespace",
        "multi": true,
        "name": "namespace",
        "options": [],
        "query": {
          "query": "label_values(kubevirt_vmi_info, namespace)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      },
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "mimir" },
        "definition": "label_values(kubevirt_vmi_info{namespace=~\"$namespace\"}, name)",
        "hide": 0,
        "includeAll": true,
        "allValue": ".*",
        "label": "VM",
        "multi": true,
        "name": "vm",
        "options": [],
        "query": {
          "query": "label_values(kubevirt_vmi_info{namespace=~\"$namespace\"}, name)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "annotations": { "list": [] },
  "panels": [
    {
      "type": "row",
      "title": "Inventory - What runs where",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Total VMs",
      "description": "All KubeVirt VM objects (running or stopped).",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 2,
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "unit": "short",
          "noValue": "0",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "count(kubevirt_vm_info{namespace=~\"$namespace\", name=~\"$vm\"})",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Running",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 3,
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "green" },
          "unit": "short",
          "noValue": "0",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "count(kubevirt_vm_info{status_group=\"running\", namespace=~\"$namespace\", name=~\"$vm\"})",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Not Running",
      "description": "VMs whose object exists but are not in a running state (stopped/paused/error). Shows 0 when all VMs are running.",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 4,
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "orange" },
          "unit": "short",
          "noValue": "0",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "orange", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "count(kubevirt_vm_info{status_group!=\"running\", namespace=~\"$namespace\", name=~\"$vm\"})",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Total vCPUs",
      "description": "Sum of guest vCPUs across running VMIs.",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "id": 5,
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "purple" },
          "unit": "short",
          "noValue": "0",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum(count by (namespace, name) (kubevirt_vmi_vcpu_seconds_total{namespace=~\"$namespace\", name=~\"$vm\"}))",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Allocated Memory",
      "description": "Sum of memory allocated to VM domains across running VMIs.",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 1 },
      "id": 6,
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "unit": "bytes",
          "noValue": "0",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum(kubevirt_vmi_memory_domain_bytes{namespace=~\"$namespace\", name=~\"$vm\"})",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "table",
      "title": "VM Inventory",
      "description": "One row per VM: where it runs (node), its state, machine type, IP, vCPUs, allocated memory, and guest memory utilization. The centerpiece: what's running where with what params.",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 5 },
      "id": 7,
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false,
            "filterable": true
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Phase" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "running": { "color": "green", "index": 0, "text": "Running" } } },
                  { "type": "value", "options": { "stopped": { "color": "red", "index": 1, "text": "Stopped" } } },
                  { "type": "value", "options": { "succeeded": { "color": "text", "index": 2, "text": "Succeeded" } } },
                  { "type": "value", "options": { "failed": { "color": "red", "index": 3, "text": "Failed" } } }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Memory" },
            "properties": [{ "id": "unit", "value": "bytes" }]
          },
          {
            "matcher": { "id": "byName", "options": "vCPUs" },
            "properties": [{ "id": "unit", "value": "short" }, { "id": "decimals", "value": 0 }]
          },
          {
            "matcher": { "id": "byName", "options": "Mem Used %" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "decimals", "value": 1 },
              { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient" } },
              { "id": "max", "value": 100 },
              { "id": "min", "value": 0 }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "sortBy": [{ "displayName": "VM", "desc": false }]
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "max by (namespace, name, node, phase, guest_os_machine) (kubevirt_vmi_info{namespace=~\"$namespace\", name=~\"$vm\"})",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "max by (namespace, name, machine_type, status) (kubevirt_vm_info{namespace=~\"$namespace\", name=~\"$vm\"})",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "max by (namespace, name, address) (kubevirt_vmi_status_addresses{type=\"InternalIP\", namespace=~\"$namespace\", name=~\"$vm\"})",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "count by (namespace, name) (kubevirt_vmi_vcpu_seconds_total{namespace=~\"$namespace\", name=~\"$vm\"})",
          "format": "table",
          "instant": true,
          "refId": "D"
        },
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "max by (namespace, name) (kubevirt_vmi_memory_domain_bytes{namespace=~\"$namespace\", name=~\"$vm\"})",
          "format": "table",
          "instant": true,
          "refId": "E"
        },
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "100 * (1 - sum by (namespace, name) (kubevirt_vmi_memory_unused_bytes{namespace=~\"$namespace\", name=~\"$vm\"}) / sum by (namespace, name) (kubevirt_vmi_memory_available_bytes{namespace=~\"$namespace\", name=~\"$vm\"}))",
          "format": "table",
          "instant": true,
          "refId": "F"
        }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #A": true,
              "Value #B": true,
              "Value #C": true
            },
            "indexByName": {
              "namespace": 0,
              "name": 1,
              "node": 2,
              "phase": 3,
              "status": 4,
              "machine_type": 5,
              "address": 6,
              "Value #D": 7,
              "Value #E": 8,
              "Value #F": 9,
              "guest_os_machine": 10
            },
            "renameByName": {
              "namespace": "Namespace",
              "name": "VM",
              "node": "Node",
              "phase": "Phase",
              "status": "Status",
              "machine_type": "Machine Type",
              "address": "IP",
              "guest_os_machine": "Guest Machine",
              "Value #D": "vCPUs",
              "Value #E": "Memory",
              "Value #F": "Mem Used %"
            }
          }
        }
      ]
    },
    {
      "type": "row",
      "title": "Per-VM CPU & Memory",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "id": 8,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "CPU Usage",
      "description": "Guest CPU consumption per VM (cores). rate of total CPU seconds; overlaid with the reported usage ratio.",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "id": 9,
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true,
            "axisLabel": "cores"
          },
          "unit": "short",
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum by (namespace, name) (rate(kubevirt_vmi_cpu_usage_seconds_total{namespace=~\"$namespace\", name=~\"$vm\"}[5m]))",
          "legendFormat": "{{namespace}}/{{name}} used cores",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "vCPU Wait & Delay",
      "description": "vCPU time spent waiting (guest-side) and scheduler delay (host-side). Rising values indicate CPU contention.",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "id": 10,
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "s",
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum by (namespace, name) (rate(kubevirt_vmi_vcpu_wait_seconds_total{namespace=~\"$namespace\", name=~\"$vm\"}[5m]))",
          "legendFormat": "{{namespace}}/{{name}} wait",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum by (namespace, name) (rate(kubevirt_vmi_vcpu_delay_seconds_total{namespace=~\"$namespace\", name=~\"$vm\"}[5m]))",
          "legendFormat": "{{namespace}}/{{name}} delay",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory: Used vs Allocated",
      "description": "Guest memory used (available - unused), resident set on host, and total allocated to the domain.",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "id": 11,
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "bytes",
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*allocated.*" },
            "properties": [{ "id": "custom.fillOpacity", "value": 0 }, { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } }]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum by (namespace, name) (kubevirt_vmi_memory_available_bytes{namespace=~\"$namespace\", name=~\"$vm\"} - kubevirt_vmi_memory_unused_bytes{namespace=~\"$namespace\", name=~\"$vm\"})",
          "legendFormat": "{{namespace}}/{{name}} used",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum by (namespace, name) (kubevirt_vmi_memory_resident_bytes{namespace=~\"$namespace\", name=~\"$vm\"})",
          "legendFormat": "{{namespace}}/{{name}} resident (host)",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum by (namespace, name) (kubevirt_vmi_memory_domain_bytes{namespace=~\"$namespace\", name=~\"$vm\"})",
          "legendFormat": "{{namespace}}/{{name}} allocated",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory Pressure: Swap & Page Faults",
      "description": "Guest swap traffic and page fault rates. Sustained swap-in or major faults indicate memory pressure.",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "id": 12,
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "Bps",
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*fault.*" },
            "properties": [{ "id": "unit", "value": "short" }]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum by (namespace, name) (rate(kubevirt_vmi_memory_swap_in_traffic_bytes{namespace=~\"$namespace\", name=~\"$vm\"}[5m]))",
          "legendFormat": "{{namespace}}/{{name}} swap in",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum by (namespace, name) (rate(kubevirt_vmi_memory_swap_out_traffic_bytes{namespace=~\"$namespace\", name=~\"$vm\"}[5m]))",
          "legendFormat": "{{namespace}}/{{name}} swap out",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum by (namespace, name) (rate(kubevirt_vmi_memory_pgmajfault_total{namespace=~\"$namespace\", name=~\"$vm\"}[5m]))",
          "legendFormat": "{{namespace}}/{{name}} major faults/s",
          "refId": "C"
        }
      ]
    },
    {
      "type": "row",
      "title": "Per-VM Network",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 },
      "id": 13,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Network Throughput (RX / TX)",
      "description": "Per-VM network receive and transmit rates.",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "id": 14,
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true,
            "gradientMode": "opacity"
          },
          "unit": "Bps",
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*TX.*" },
            "properties": [{ "id": "custom.transform", "value": "negative-Y" }]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum by (namespace, name) (rate(kubevirt_vmi_network_receive_bytes_total{namespace=~\"$namespace\", name=~\"$vm\"}[5m]))",
          "legendFormat": "{{namespace}}/{{name}} RX",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum by (namespace, name) (rate(kubevirt_vmi_network_transmit_bytes_total{namespace=~\"$namespace\", name=~\"$vm\"}[5m]))",
          "legendFormat": "{{namespace}}/{{name}} TX",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Network Packets & Drops",
      "description": "Packet rates plus dropped packets. Non-zero drops indicate saturation or errors.",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 31 },
      "id": 15,
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "pps",
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*drop.*" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum by (namespace, name) (rate(kubevirt_vmi_network_receive_packets_total{namespace=~\"$namespace\", name=~\"$vm\"}[5m]))",
          "legendFormat": "{{namespace}}/{{name}} RX pkts",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum by (namespace, name) (rate(kubevirt_vmi_network_transmit_packets_total{namespace=~\"$namespace\", name=~\"$vm\"}[5m]))",
          "legendFormat": "{{namespace}}/{{name}} TX pkts",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum by (namespace, name) (rate(kubevirt_vmi_network_receive_packets_dropped_total{namespace=~\"$namespace\", name=~\"$vm\"}[5m]) + rate(kubevirt_vmi_network_transmit_packets_dropped_total{namespace=~\"$namespace\", name=~\"$vm\"}[5m]))",
          "legendFormat": "{{namespace}}/{{name}} drops",
          "refId": "C"
        }
      ]
    },
    {
      "type": "row",
      "title": "Per-VM Storage",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 39 },
      "id": 16,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Storage Throughput (Read / Write)",
      "description": "Per-disk read and write byte rates, broken out by drive.",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "id": 17,
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "Bps",
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*write.*" },
            "properties": [{ "id": "custom.transform", "value": "negative-Y" }]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum by (namespace, name, drive) (rate(kubevirt_vmi_storage_read_traffic_bytes_total{namespace=~\"$namespace\", name=~\"$vm\"}[5m]))",
          "legendFormat": "{{name}} {{drive}} read",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum by (namespace, name, drive) (rate(kubevirt_vmi_storage_write_traffic_bytes_total{namespace=~\"$namespace\", name=~\"$vm\"}[5m]))",
          "legendFormat": "{{name}} {{drive}} write",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Storage IOPS (Read / Write)",
      "description": "Per-disk read and write IOPS, broken out by drive.",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "id": 18,
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "iops",
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*write.*" },
            "properties": [{ "id": "custom.transform", "value": "negative-Y" }]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum by (namespace, name, drive) (rate(kubevirt_vmi_storage_iops_read_total{namespace=~\"$namespace\", name=~\"$vm\"}[5m]))",
          "legendFormat": "{{name}} {{drive}} read",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum by (namespace, name, drive) (rate(kubevirt_vmi_storage_iops_write_total{namespace=~\"$namespace\", name=~\"$vm\"}[5m]))",
          "legendFormat": "{{name}} {{drive}} write",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Storage Latency (avg per op)",
      "description": "Average read/write latency per operation, derived from cumulative time over IOPS per drive.",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 48 },
      "id": 19,
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "s",
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum by (namespace, name, drive) (rate(kubevirt_vmi_storage_read_times_seconds_total{namespace=~\"$namespace\", name=~\"$vm\"}[5m])) / clamp_min(sum by (namespace, name, drive) (rate(kubevirt_vmi_storage_iops_read_total{namespace=~\"$namespace\", name=~\"$vm\"}[5m])), 1)",
          "legendFormat": "{{name}} {{drive}} read",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum by (namespace, name, drive) (rate(kubevirt_vmi_storage_write_times_seconds_total{namespace=~\"$namespace\", name=~\"$vm\"}[5m])) / clamp_min(sum by (namespace, name, drive) (rate(kubevirt_vmi_storage_iops_write_total{namespace=~\"$namespace\", name=~\"$vm\"}[5m])), 1)",
          "legendFormat": "{{name}} {{drive}} write",
          "refId": "B"
        }
      ]
    },
    {
      "type": "row",
      "title": "Guest / Virt Params",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 56 },
      "id": 20,
      "panels": []
    },
    {
      "type": "table",
      "title": "Guest & Virt Parameters",
      "description": "Static virt params per VM: node, phase, machine type/model, guest OS (from VMI spec; often <none> when not annotated), evictable, and outdated-launcher flag. Live-migration eligibility is signalled by the 'Evictable' column.",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 57 },
      "id": 21,
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false,
            "filterable": true
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Outdated" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "true": { "color": "orange", "index": 0, "text": "Yes (needs restart)" } } },
                  { "type": "value", "options": { "false": { "color": "green", "index": 1, "text": "No" } } }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "sortBy": [{ "displayName": "VM", "desc": false }]
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "max by (namespace, name, node, phase, guest_os_machine, os, instance_type, evictable, outdated) (kubevirt_vmi_info{namespace=~\"$namespace\", name=~\"$vm\"})",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "max by (namespace, name, machine_type) (kubevirt_vm_info{namespace=~\"$namespace\", name=~\"$vm\"})",
          "format": "table",
          "instant": true,
          "refId": "B"
        }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Value #A": true, "Value #B": true },
            "indexByName": {
              "namespace": 0,
              "name": 1,
              "node": 2,
              "phase": 3,
              "machine_type": 4,
              "guest_os_machine": 5,
              "os": 6,
              "instance_type": 7,
              "evictable": 8,
              "outdated": 9
            },
            "renameByName": {
              "namespace": "Namespace",
              "name": "VM",
              "node": "Node",
              "phase": "Phase",
              "machine_type": "Machine Type",
              "guest_os_machine": "Guest Machine",
              "os": "Guest OS",
              "instance_type": "Instance Type",
              "evictable": "Evictable",
              "outdated": "Outdated"
            }
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "VM Migrations by Phase",
      "description": "Count of VM migrations currently in each phase (pending, scheduling, running). Spikes indicate live-migration activity.",
