          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "sum by (node) (changes(kube_pod_created[5m]) * on(pod,namespace) group_left() kube_pod_info)",
          "legendFormat": "{{node}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
