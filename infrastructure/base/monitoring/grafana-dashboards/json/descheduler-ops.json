    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "id": 13,
      "title": "Immovable pods by class (per node)",
      "type": "timeseries",
      "description": "DaemonSet pods can never be moved \u2014 one per node by definition. On talos02-gpu these are 13 of 109. Also protected but not charted here: 23 pods pinned by nodeSelector/affinity (nodeFit:true blocks eviction unless another node genuinely satisfies them) and every pod holding a local-path PVC (podProtections by storage class). That last guard is the critical one: local-path uses WaitForFirstConsumer, so the PV is pinned to its node and an evicted pod would be stranded Pending forever.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "count by (node) (kube_pod_owner{owner_kind=\"DaemonSet\"} * on(pod,namespace) group_left(node) kube_pod_info)",
          "legendFormat": "DaemonSet {{node}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "id": 14,
      "title": "Pending pods (must stay at zero)",
      "type": "timeseries",
      "description": "THE regression alarm for this whole feature. If a rebalance strands a pod \u2014 most plausibly one holding a node-pinned local-path PV \u2014 it lands here and stays. A brief blip during normal scheduling is fine; a Pending pod that persists after a descheduler run means a protection failed and should be investigated immediately.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "sum by (namespace) (kube_pod_status_phase{phase=\"Pending\"} > 0)",
          "legendFormat": "{{namespace}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
