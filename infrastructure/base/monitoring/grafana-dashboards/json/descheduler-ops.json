      "title": "Balance \u2014 what the descheduler acts on",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "id": 2,
      "title": "Pods per node vs the 200 ceiling",
      "type": "timeseries",
      "description": "THE core panel. The descheduler's LowNodeUtilization plugin balances on this. Before 2026-08-21 the ceiling was 110 and talos02-gpu sat at 109 \u2014 a node at maxPods REJECTS new pods, which silently cancelled 22 Velero PodVolumeBackups a night and made the daily backup PartiallyFailed for 3 days. maxPods is now 200. The hard limit is the per-node /24 pod CIDR (254 usable), so ~240 is the absolute ceiling; above that kubelet admits pods Cilium cannot address and they wedge in ContainerCreating. See TALOS-d5b5.",
      "gridPos": {
        "h": 9,
        "w": 14,
        "x": 0,
        "y": 1
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "count by (node) (kube_pod_info{node!=\"\"})",
          "legendFormat": "{{node}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "max by (node) (kube_node_status_capacity{resource=\"pods\"})",
          "legendFormat": "capacity",
          "range": true,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "id": 3,
      "title": "Pod utilisation % \u2014 with the action thresholds",
      "type": "timeseries",
      "description": "The descheduler classifies each node against these two lines. ABOVE 65% = overutilized, it evicts. BELOW 40% = underutilized, it receives. IN BETWEEN = left alone deliberately. A flat run with everything in-band and zero evictions is the intended steady state, NOT a broken balancer.",
      "gridPos": {
        "h": 9,
        "w": 10,
        "x": 14,
        "y": 1
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "100 * (count by (node) (kube_pod_info{node!=\"\"})) / on(node) group_left() (max by (node) (kube_node_status_capacity{resource=\"pods\"}))",
          "legendFormat": "{{node}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "vector(65)",
          "legendFormat": "target: evict above",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "vector(40)",
          "legendFormat": "threshold: receive below",
          "range": true,
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "percent"
        },
        "overrides": []
      }
    },
