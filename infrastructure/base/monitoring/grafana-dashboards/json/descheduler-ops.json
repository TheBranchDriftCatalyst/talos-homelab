      "id": 10,
      "title": "Pod churn per node (creations/5m)",
      "type": "timeseries",
      "description": "A spike on one node with a matching dip elsewhere is a rebalance landing. Sustained churn everywhere is NOT the descheduler \u2014 with maxNoOfPodsToEvictTotal:3 it can move at most 3 pods per run, so it can never be the cause of large-scale churn.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "options": {
        "legend": {
          "calcs": [
