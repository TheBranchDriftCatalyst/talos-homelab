          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2,
            "showPoints": "auto",
            "spanNulls": true,
            "stepAfter": true
          }
        },
        "overrides": []
      }
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki-v2"
      },
      "id": 19,
      "type": "logs",
      "title": "Errors and skipped evictions",
