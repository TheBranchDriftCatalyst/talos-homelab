{
  "uid": "falco-ops",
  "title": "Falco \u00b7 Runtime Security",
  "tags": [
    "security",
    "falco",
    "runtime"
  ],
  "schemaVersion": 39,
  "editable": true,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 11,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Total alerts (range)",
      "description": "All Falco events in the window.",
      "datasource": {
        "type": "loki",
        "uid": "loki-v2"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki-v2"
          },
          "expr": "sum(count_over_time({rule=~\".+\"}[$__range]))",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 13,
      "type": "stat",
      "title": "CRITICAL+ (range)",
      "description": "Critical/Alert/Emergency events.",
      "datasource": {
        "type": "loki",
        "uid": "loki-v2"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki-v2"
          },
          "expr": "sum(count_over_time({rule=~\".+\", priority=~\"Critical|Emergency|Alert\"}[$__range]))",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 14,
      "type": "stat",
      "title": "HONEYPOT BREACHES",
