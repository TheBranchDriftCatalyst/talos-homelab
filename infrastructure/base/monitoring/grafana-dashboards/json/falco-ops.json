        "type": "loki",
        "uid": "loki-v2"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki-v2"
          },
          "expr": "sum(count_over_time({rule=~\"Honeypot Container Breach.*\"}[$__range]))",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Distinct rules firing",
      "description": "How many distinct Falco rules fired.",
      "datasource": {
        "type": "loki",
        "uid": "loki-v2"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki-v2"
          },
          "expr": "count(sum by (rule) (count_over_time({rule=~\".+\"}[$__range])))",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Alerts over time by priority",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki-v2"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 40,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki-v2"
          },
          "expr": "sum by (priority) (count_over_time({rule=~\".+\"}[$__interval]))",
          "legendFormat": "{{priority}}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 17,
      "type": "row",
      "title": "Breakdown",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      }
    },
    {
      "id": 18,
      "type": "table",
      "title": "Top rules",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki-v2"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki-v2"
          },
          "expr": "topk(15, sum by (rule) (count_over_time({rule=~\".+\"}[$__range])))",
          "queryType": "instant",
          "format": "table"
        }
      ]
    },
    {
      "id": 19,
      "type": "table",
      "title": "Top workloads (ns / pod)",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki-v2"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki-v2"
          },
          "expr": "topk(15, sum by (k8s_ns_name, k8s_pod_name) (count_over_time({rule=~\".+\"}[$__range])))",
          "queryType": "instant",
          "format": "table"
        }
      ]
    },
