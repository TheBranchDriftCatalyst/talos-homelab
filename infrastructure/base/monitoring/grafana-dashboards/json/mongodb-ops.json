{
  "annotations": {
    "list": []
  },
  "description": "MongoDB operational dashboard, fed by the percona/mongodb_exporter sidecar and the cluster-wide mongodb-clusters PodMonitor. Mirrors the CNPG dashboard's role for Postgres. Every metric was grounded against Mimir at authoring time.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": [],
      "title": "Overview",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "id": 2,
      "title": "Up",
      "type": "stat",
      "description": "Exporter's view of mongod. 0 means the SIDECAR cannot reach mongod \u2014 the pod may still look Ready, so trust this over pod status.",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "mongodb_up{namespace=~\"$namespace\",pod=~\"$pod\"}",
          "legendFormat": "up",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "id": 3,
      "title": "PRIMARY members",
      "type": "stat",
      "description": "Count of members reporting rs_state=1 (PRIMARY). Should be exactly 1 per replica set: 0 means the set has no primary and writes are failing; >1 across one rs_nm would indicate a split brain. rs_state is a LABEL on every exporter metric, which is why this counts series rather than reading a value. (Uses mongodb_ss_uptime, not mongodb_up \u2014 mongodb_up does NOT carry the rs_state label, so selecting on it silently matched nothing and read 0 while the member was in fact PRIMARY.)",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 3,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "count(mongodb_ss_uptime{namespace=~\"$namespace\",pod=~\"$pod\",rs_state=\"1\"}) or vector(0)",
          "legendFormat": "primaries",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              },
              {
                "color": "orange",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "id": 4,
      "title": "Uptime",
      "type": "stat",
      "description": "Seconds since mongod started. A resetting value is a restart you may not have noticed.",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "mongodb_ss_uptime{namespace=~\"$namespace\",pod=~\"$pod\"}",
          "legendFormat": "uptime",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "s",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "id": 5,
      "title": "Current connections",
      "type": "stat",
      "description": "Open client connections.",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 9,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "sum(mongodb_ss_connections{namespace=~\"$namespace\",pod=~\"$pod\",conn_type=\"current\"})",
          "legendFormat": "current",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 500
              },
              {
                "color": "red",
                "value": 5000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "id": 6,
      "title": "Connection utilisation",
      "type": "stat",
      "description": "current / (current + available). Mongo refuses new connections at 100%, and connection exhaustion presents to apps as timeouts, not as an error from the DB.",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "100 * sum(mongodb_ss_connections{namespace=~\"$namespace\",pod=~\"$pod\",conn_type=\"current\"}) / clamp_min(sum(mongodb_ss_connections{namespace=~\"$namespace\",pod=~\"$pod\",conn_type=\"current\"}) + sum(mongodb_ss_connections{namespace=~\"$namespace\",pod=~\"$pod\",conn_type=\"available\"}),1)",
          "legendFormat": "% used",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percent",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "id": 7,
      "title": "WiredTiger cache used",
      "type": "stat",
      "description": "Sustained >95% means WiredTiger is evicting constantly and reads start hitting disk \u2014 the usual cause of a Mongo that is 'slow' with no obvious CPU or memory pressure.",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 15,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "100 * sum(mongodb_ss_wt_cache_bytes_currently_in_the_cache{namespace=~\"$namespace\",pod=~\"$pod\"}) / clamp_min(sum(mongodb_ss_wt_cache_maximum_bytes_configured{namespace=~\"$namespace\",pod=~\"$pod\"}),1)",
          "legendFormat": "% of cache",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 80
              },
              {
                "color": "red",
                "value": 95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "id": 8,
      "title": "Asserts (5m)",
      "type": "stat",
      "description": "Server-side assertion failures. Should be flat zero; any sustained rate is a real fault worth reading the mongod log for.",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "sum(increase(mongodb_ss_asserts{namespace=~\"$namespace\",pod=~\"$pod\"}[5m]))",
          "legendFormat": "asserts",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "id": 9,
      "title": "Data size",
      "type": "stat",
      "description": "Logical data size across databases (excludes indexes \u2014 see the storage row).",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 21,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "sum(mongodb_mongod_db_data_size_bytes{namespace=~\"$namespace\",pod=~\"$pod\"})",
          "legendFormat": "data",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "bytes",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 10,
      "panels": [],
      "title": "Operations",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "id": 11,
      "title": "Operations/sec by type",
      "type": "timeseries",
      "description": "opcounters rate. The shape matters more than the magnitude: a sudden command/query spike with flat inserts usually means a client retry storm rather than real load.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "sum by (legacy_op_type) (rate(mongodb_ss_opcounters{namespace=~\"$namespace\",pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "{{legacy_op_type}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "id": 12,
      "title": "Document operations/sec",
      "type": "timeseries",
      "description": "Documents actually touched (inserted/updated/deleted/returned). 'returned' climbing far faster than the query rate points at unindexed queries scanning collections.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "sum by (doc_op_type) (rate(mongodb_ss_metrics_document{namespace=~\"$namespace\",pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "{{doc_op_type}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "id": 13,
      "title": "Global lock queue",
      "type": "timeseries",
      "description": "Operations WAITING on the global lock. Anything sustained above zero means contention \u2014 this is the first place to look when Mongo feels slow but CPU is idle.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "sum by (count_type) (mongodb_ss_globalLock_currentQueue{namespace=~\"$namespace\",pod=~\"$pod\"})",
          "legendFormat": "queued {{count_type}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 25,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "id": 14,
      "title": "Active clients",
      "type": "timeseries",
      "description": "Clients actively reading/writing. Compare against the queue panel: high active + zero queued is healthy throughput; high queued is contention.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "sum by (count_type) (mongodb_ss_globalLock_activeClients_readers{namespace=~\"$namespace\",pod=~\"$pod\"})",
          "legendFormat": "readers",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "sum by (count_type) (mongodb_ss_globalLock_activeClients_writers{namespace=~\"$namespace\",pod=~\"$pod\"})",
          "legendFormat": "writers",
          "refId": "B",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "id": 15,
      "panels": [],
      "title": "Resources",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "id": 16,
      "title": "WiredTiger cache",
      "type": "timeseries",
      "description": "Cache pressure. 'in cache' pinned at 'configured max' with rising eviction is the classic under-provisioned-cache signature.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "sum(mongodb_ss_wt_cache_bytes_currently_in_the_cache{namespace=~\"$namespace\",pod=~\"$pod\"})",
          "legendFormat": "in cache",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "sum(mongodb_ss_wt_cache_maximum_bytes_configured{namespace=~\"$namespace\",pod=~\"$pod\"})",
          "legendFormat": "configured max",
          "refId": "B",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "sum(mongodb_ss_wt_cache_bytes_dirty_in_the_cache_cumulative{namespace=~\"$namespace\",pod=~\"$pod\"})",
          "legendFormat": "dirty (cumulative)",
          "refId": "C",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "id": 17,
      "title": "Memory (resident vs virtual)",
      "type": "timeseries",
      "description": "mongod's own view of memory (reported in MiB, converted here). Compare resident against the container limit \u2014 WiredTiger sizes its cache from the limit, so an undersized limit shows up as cache pressure first.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "sum(mongodb_ss_mem_resident{namespace=~\"$namespace\",pod=~\"$pod\"}) * 1024 * 1024",
          "legendFormat": "resident",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "sum(mongodb_ss_mem_virtual{namespace=~\"$namespace\",pod=~\"$pod\"}) * 1024 * 1024",
          "legendFormat": "virtual",
          "refId": "B",
