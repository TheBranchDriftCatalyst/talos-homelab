          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "app": true,
              "app_kubernetes_io_name": true,
              "container": true,
              "cluster": true,
              "endpoint": true,
              "service": true
