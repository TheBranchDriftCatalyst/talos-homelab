            "renameByName": {
              "job": "Job",
              "namespace": "Namespace",
              "pod": "Pod",
              "instance": "Instance",
              "node": "Node"
            }
          }
        }
      ],
      "description": "Scrape targets currently failing. Many kubernetes-pods entries are code-server pods annotated for scrape but exposing no /metrics."
